#!/bin/sh
set -e
if [ "$1" = configure ]; then
    getent passwd nova-api >/dev/null || useradd --system --home-dir /var/lib/nova-api --shell /usr/sbin/nologin nova-api
    install -d -o nova-api -g nova-api -m 750 /var/lib/nova-api /var/lib/nova-api/apk /var/log/nova-api
    install -d -m 750 -g nova-api /etc/nova-api
    install -d -m 755 /etc/nova/plugins
    rm -f /etc/sudoers.d/nova-api           # very old source installs used a sudo rule
    systemctl daemon-reload || true
    systemctl enable --now nova-helper.socket >/dev/null 2>&1 || true
    systemctl enable --now nova-update-check.timer >/dev/null 2>&1 || true
    # Monitoring + alerts (Status page, Inbox, phone and Discord alerts). Works out mounts and
    # services by itself; settings in /etc/nova-alerts/config.json (root only: it may hold a webhook).
    install -d -m 755 /var/lib/nova-alerts /var/lib/nova-alerts/www
    install -d -m 700 /var/lib/nova-alerts/spool /etc/nova-alerts
    [ -f /etc/nova-alerts/config.json ] || { echo '{}' > /etc/nova-alerts/config.json; chmod 600 /etc/nova-alerts/config.json; }
    systemctl enable --now nova-alerts.timer >/dev/null 2>&1 || true
    systemctl enable --now nova-alerts.path >/dev/null 2>&1 || true    # a new message goes out the moment it's queued
    # Backups (Storage → Backups): jobs in /etc/nova-backup (root only: may hold NAS passwords)
    install -d -m 700 /etc/nova-backup /etc/nova-backup/secrets
    install -d -m 755 /var/lib/nova-backups
    systemctl enable --now nova-backups.timer >/dev/null 2>&1 || true
    systemctl enable --now nova-labs.timer >/dev/null 2>&1 || true
    if [ -f /etc/nova-api/config.json ]; then
        systemctl enable nova-api.service >/dev/null 2>&1 || true
        systemctl restart nova-api.service || true
        # lighting module set up (nova-setup-lighting): make sure the boot/shutdown unit is active,
        # so the lights switch off at the next shutdown, and the animator is running
        if systemctl is-enabled nova-rgb-restore.service >/dev/null 2>&1; then
            systemctl is-active nova-rgb-restore.service >/dev/null 2>&1 || systemctl start nova-rgb-restore.service || true
            systemctl enable nova-rgb-anim.service >/dev/null 2>&1 || true
            systemctl restart nova-rgb-anim.service || true
        fi
        echo "Nova updated and restarted."
    else
        command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q /usr/share/icons/hicolor >/dev/null 2>&1 || true
        echo ""
        echo "  Nova is installed. Next, set it up (about five minutes):"
        echo ""
        echo "    sudo nova setup            questions in this terminal"
        echo "    sudo nova setup --gui      the same in a browser (this computer, or a phone or laptop at home)"
        echo "    Set up Nova                in your apps menu, on a computer with a desktop"
        echo ""
        echo "  Stuck?  nova help"
        echo ""
        # installed from a desktop's software app (no terminal to read the above): a notification on each signed-in desktop
        for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
            t=$(loginctl show-session "$s" -p Type --value 2>/dev/null); case "$t" in x11|wayland) ;; *) continue ;; esac
            uid=$(loginctl show-session "$s" -p User --value 2>/dev/null); u=$(id -nu "$uid" 2>/dev/null) || continue
            command -v notify-send >/dev/null 2>&1 || break
            timeout 5 runuser -u "$u" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" notify-send -i nova \
                "Nova is installed" "Open “Set up Nova” from your apps to finish setting it up." >/dev/null 2>&1 || true
        done
    fi
fi
exit 0
