[Unit]
Description=Nova backups: start any backup that is due (each runs as its own task)
After=local-fs.target remote-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/nova-api/backups.py tick
TimeoutStartSec=120
# Quiet in the journal: this runs every few seconds to a minute, and "Starting… / Finished…" for every pass crowded out
# everything else (about four lines in ten on a home server). Errors are still logged, as warnings.
StandardOutput=null
StandardError=journal
SyslogLevel=warning
LogLevelMax=notice
