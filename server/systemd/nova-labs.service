[Unit]
Description=Nova Labs: crash-loop guard and weekly container updates (only what you turned on)
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/nova-api/labs.py tick
TimeoutStartSec=120
# Quiet in the journal: this runs every few seconds to a minute, and "Starting… / Finished…" for every pass crowded out
# everything else (about four lines in ten on a home server). Errors are still logged, as warnings.
StandardOutput=null
StandardError=journal
SyslogLevel=warning
LogLevelMax=notice
