[Unit]
Description=Fan light animator (software effects such as wave; idle otherwise)
After=nova-rgb-restore.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/nova-rgb/nova_rgb.py animate
User=nova-api
Group=nova-api
SupplementaryGroups=nova-rgb
Restart=always
RestartSec=5
Nice=5
ProtectSystem=strict
ReadWritePaths=/var/lib/nova-rgb
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
PrivateNetwork=yes

[Install]
WantedBy=multi-user.target
