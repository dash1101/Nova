#!/usr/bin/python3 -I
"""
nova-update — install a signed Nova release (server package + app for the in-app updater).

    sudo nova-update --check             is there something newer? (no changes)
    sudo nova-update                     install the newest release from the configured source
    sudo nova-update github:owner/repo   … from that GitHub repo's releases instead
    sudo nova-update /path/to/release    install from a folder (or a single SHA256SUMS-signed set)

A release is a folder (or a GitHub release) containing:
    nova-server_<version>_all.deb   nova-<version>-universal.apk (optional)
    SHA256SUMS                      SHA256SUMS.sig  (Ed25519 signature by the Nova release key)

Nothing is installed unless SHA256SUMS is signed by the release key shipped in this package and
every file matches it. Downgrades are refused (unless --allow-downgrade).
Source: "update_source" in /etc/nova-api/config.json — blank (Nova's official releases), "github:owner/repo",
a local folder, or "manual" (never checks by itself; sudo nova update at the server still installs the official release).
Status for the app: /var/lib/nova-api/update.json
"""
import hashlib, json, os, re, shutil, subprocess, sys, tempfile, time, urllib.request

# The public half of the release key ships with the package; in a source checkout it's in packaging/.
KEY = next((p for p in ("/usr/lib/nova-api/release-key.pub",
                        os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "packaging", "release-key.pub"))
            if os.path.exists(p)), None)
CONF, STATUS = "/etc/nova-api/config.json", "/var/lib/nova-api/update.json"
ARGS = [a for a in sys.argv[1:] if not a.startswith("--")]
FLAGS = {a for a in sys.argv[1:] if a.startswith("--")}


def say(m): print(m, flush=True)
def pretty(v): return (v or "").replace("~", "-")           # Debian spells it 0.9.17~alpha; people see 0.9.17-alpha


def check_everything():
    """The daily check: packages and containers too (Updates screen), with one notification when new ones appear."""
    sys.path.insert(0, "/usr/lib/nova-api")
    try:
        import updates
        r = updates.check(log=lambda m: None)
    except Exception as e:
        say(f"(couldn't check packages and containers: {e})"); return
    prev = {}
    try: prev = json.load(open(STATUS))
    except Exception: pass
    seen = prev.get("updates_notified", 0)
    if r["count"] > seen:
        a = shutil.which("nova-alert") or "/usr/sbin/nova-alert"
        parts = [f"{r['apt']} package{'s' if r['apt'] != 1 else ''}" if r["apt"] else "", f"{r['containers']} container{'s' if r['containers'] != 1 else ''}" if r["containers"] else ""]
        if os.path.exists(a) and any(parts):
            subprocess.run([a, "info", f"{r['count']} updates ready", " and ".join(p for p in parts if p) + " can be updated — Nova → Menu → Updates."],
                           env={**os.environ, "NOVA_ALERT_CATEGORY": "update"}, capture_output=True)
    status(updates_notified=r["count"])
    say(f"{r['count']} updates for packages and containers")

def status(**kv):
    try: cur = json.load(open(STATUS))
    except Exception: cur = {}
    cur.update(kv, t=int(time.time()))
    sys.path.insert(0, "/usr/lib/nova-api"); sys.path.insert(1, os.path.dirname(os.path.realpath(__file__)))
    import safeio                                         # the nova-api account owns this folder: no symlinks followed
    try: safeio.write_json(STATUS, cur, 0o640, "nova-api", "nova-api")
    except KeyError: safeio.write_json(STATUS, cur, 0o640)


def fail(m, code=1):
    status(state="failed", error=m); say(f"✗ {m}"); sys.exit(code)


class Offline(Exception):
    """The update source couldn't be reached (no network yet, GitHub busy) — not a problem with Nova or its releases."""


def _dpkg_owns():
    """Is Nova installed as the .deb? (Then that's how it updates, even if a tarball install once left its marker behind.)"""
    if not shutil.which("dpkg-query"): return False
    r = subprocess.run(["dpkg-query", "-W", "-f=${Status}", "nova-server"], capture_output=True, text=True)
    return r.returncode == 0 and "install ok installed" in r.stdout

TARBALL = not _dpkg_owns() and (os.path.exists("/usr/lib/nova-api/INSTALLED_FROM_TARBALL") or not shutil.which("dpkg-query"))   # any Linux (install.sh)

def installed_version():
    if not TARBALL:
        r = subprocess.run(["dpkg-query", "-W", "-f=${Version}", "nova-server"], capture_output=True, text=True)
        if r.returncode == 0: return r.stdout.strip()
    try: return open("/usr/lib/nova-api/VERSION").read().strip()
    except OSError: return ""


def _vkey(v):
    """Debian-style ordering without dpkg: 0.7.0~alpha < 0.7.0 < 0.7.1."""
    out = []
    for part in re.split(r"[.+-]", v):
        main, _, pre = part.partition("~")
        out.append((int(main) if main.isdigit() else 0, 0 if pre else 1, pre))
    return out

def newer(a, b):          # is a newer than b (Debian version rules)
    if shutil.which("dpkg"): return subprocess.run(["dpkg", "--compare-versions", a, "gt", b]).returncode == 0
    return _vkey(a) > _vkey(b)


def verify_sums(sums: bytes, sig: bytes):
    from cryptography.hazmat.primitives import serialization
    from cryptography.exceptions import InvalidSignature
    import base64
    if not KEY: fail("no release key installed — can't verify updates")
    pub = serialization.load_pem_public_key(open(KEY, "rb").read())
    try: pub.verify(base64.b64decode(sig.strip()), sums)
    except (InvalidSignature, ValueError): fail("the release signature is NOT valid — refusing to install")


def fetch(url, dest=None, limit=200 * 1024 * 1024):
    if not url.startswith("https://"): fail("refusing a non-https download")
    req = urllib.request.Request(url, headers={"User-Agent": "nova-update", "Accept": "application/octet-stream"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            data = r.read(limit + 1)
    except urllib.error.HTTPError as e:
        if e.code in (403, 429) or e.code >= 500: raise Offline(f"{'GitHub' if 'github' in url else 'the update source'} is busy right now ({e.code})")
        fail(f"{'GitHub' if 'github' in url else 'the update source'} answered {e.code} for {url.split('?')[0]}" + (" (no release published yet?)" if e.code == 404 else ""))
    except (urllib.error.URLError, OSError) as e:
        raise Offline(f"couldn't reach {url.split('/')[2]}: {getattr(e, 'reason', e)}")
    if len(data) > limit: fail("download too large")
    if dest: open(dest, "wb").write(data)
    return data


def release_url(repo, name):
    """Where a file of the newest release is. (Not GitHub's API: it lets one address ask only 60 times an hour — everyone
    behind that address together — and the plain download links say the same. GitHub stores "~" in a name as ".".)"""
    return f"https://github.com/{repo}/releases/latest/download/{name.replace('~', '.')}"

def _repo(src):
    repo = src.split(":", 1)[1]
    if not re.fullmatch(r"[\w.-]+/[\w.-]+", repo): fail("bad github source")
    return repo

def gather(src, work):
    """Get the release's signed list of files into `work`, check its signature, and return {name: checksum}.
    Nothing else is fetched yet: the list alone says which version the release is, which is all a check needs.
    (Every check used to download the whole release — every package for every system and the apps.)"""
    for need in ("SHA256SUMS", "SHA256SUMS.sig"):
        if src.startswith("github:"): fetch(release_url(_repo(src), need), os.path.join(work, need), limit=1 << 20)
        elif not os.path.isdir(src): fail(f"{src} isn't a folder")
        elif os.path.exists(os.path.join(src, need)): shutil.copy(os.path.join(src, need), work)
    sums = open(os.path.join(work, "SHA256SUMS"), "rb").read() if os.path.exists(os.path.join(work, "SHA256SUMS")) else fail("no SHA256SUMS")
    sig = open(os.path.join(work, "SHA256SUMS.sig"), "rb").read() if os.path.exists(os.path.join(work, "SHA256SUMS.sig")) else fail("no SHA256SUMS.sig — unsigned release")
    verify_sums(sums, sig)
    return parse_sums(sums)

def take(src, work, listed, names):
    """Fetch these files of the release (only the ones this server installs) and check each against its signed checksum."""
    for name in names:
        dest = os.path.join(work, name)
        if src.startswith("github:"): fetch(release_url(_repo(src), name), dest)
        elif os.path.exists(os.path.join(src, name)): shutil.copy(os.path.join(src, name), dest)
        else: fail(f"{name} is in the release's list but not in {src}")
        if hashlib.sha256(open(dest, "rb").read()).hexdigest() != listed[name]: fail(f"{name} doesn't match its signed checksum")

def parse_sums(b):
    out = {}
    for line in b.decode().splitlines():
        m = re.fullmatch(r"([0-9a-f]{64})\s+\*?([\w.+~-]+)", line.strip())
        if m: out[m.group(2)] = m.group(1)
    return out


OFFICIAL = "github:dash1101/Nova"          # where Nova's signed releases are published

def main():
    if os.geteuid() != 0: sys.exit("run with sudo")
    cfg = {}
    try: cfg = json.load(open(CONF))
    except Exception: pass
    src = ARGS[0] if ARGS else (cfg.get("update_source") or OFFICIAL)      # (left blank in setup: Nova's own signed releases)
    cur = installed_version()
    if src == "manual":
        # "manual": Nova never looks by itself (no daily check, no update from the app) — but a person who runs
        # sudo nova update at the server gets Nova's official release, as nova setup promises.
        if sys.stdin.isatty(): src = OFFICIAL
        elif "--check" in FLAGS:
            status(state="manual", current=cur, source="manual", error=""); say("updates are set to manual on this server — nothing checked"); return
        else: fail("updates are set to manual on this server — run sudo nova update there", 2)
    status(state="checking", current=cur, source=src)
    work = tempfile.mkdtemp(prefix="nova-update-")
    try:
        # The daily check (--patient, from its timer) often runs right after boot, before Wi-Fi is up: it waits for the network
        # a few minutes, and if it's still offline that's not a failure — it says so and looks again tomorrow.
        tries = 5 if "--patient" in FLAGS else 1
        for i in range(tries):
            try: listed = gather(os.path.abspath(src) if not src.startswith("github:") else src, work); break
            except Offline as e:
                if i + 1 < tries: time.sleep(30 * (i + 1)); continue
                if "--patient" in FLAGS:
                    status(state="offline", current=cur, error=str(e)); say(f"couldn't check for updates: {e} — trying again tomorrow"); return
                fail(str(e))
        if TARBALL:
            debs = sorted(n for n in listed if re.fullmatch(r"nova-server_[\w.~+-]+\.tar\.gz", n))
            if not debs: fail("the release has no server tarball (nova-server_<version>.tar.gz) for this Linux")
            deb = debs[-1]; ver = deb[len("nova-server_"):-len(".tar.gz")]
        else:
            debs = sorted(n for n in listed if n.startswith("nova-server_") and n.endswith("_all.deb"))
            if not debs: fail("the release has no server package")
            deb = debs[-1]; ver = deb[len("nova-server_"):-len("_all.deb")]
        avail_newer = not cur or newer(ver, cur)
        status(state="available" if avail_newer else "current", current=cur, available=ver, error="")
        if "--check" in FLAGS:
            prev = {}
            try: prev = json.load(open(STATUS))
            except Exception: pass
            if avail_newer and prev.get("notified") != ver:            # once per new version
                a = shutil.which("nova-alert") or "/usr/sbin/nova-alert"
                if os.path.exists(a):
                    subprocess.run([a, "info", f"Server update available: Nova {pretty(ver)}", f"You have {pretty(cur)}. Install it from Nova → Settings → Software update (or: sudo nova update)."],
                                   env={**os.environ, "NOVA_ALERT_CATEGORY": "update"}, capture_output=True)
                status(notified=ver)
            say(f"installed {pretty(cur) or 'none'} · newest release {pretty(ver)} · {'update available — sudo nova update installs it' if avail_newer else 'up to date'}")
            if "--all" in FLAGS: check_everything()
            return
        if not avail_newer and "--allow-downgrade" not in FLAGS and "--reinstall" not in FLAGS:
            say(f"✓ already up to date ({pretty(cur)})"); return
        say(f"→ installing Nova {pretty(ver)} (signature and checksums verified)")
        status(state="installing", available=ver)
        apks = sorted(n for n in listed if n.endswith("-universal.apk"))
        try: take(src if src.startswith("github:") else os.path.abspath(src), work, listed, [deb] + apks[-1:])      # this system's package and the app — not the rest of the release
        except Offline as e: fail(str(e))
        keep = None
        if apks:                                             # stage the app before the server restarts
            keep = os.path.join(tempfile.mkdtemp(prefix="nova-apk-"), apks[-1]); shutil.copy(os.path.join(work, apks[-1]), keep)
        if TARBALL:                                          # unpack (signed, checked above) and run its installer in upgrade mode
            x = os.path.join(work, "x"); os.makedirs(x)
            import tarfile
            with tarfile.open(os.path.join(work, deb)) as t: t.extractall(x, filter="data")
            inst = next((os.path.join(x, d, "install.sh") for d in os.listdir(x) if os.path.exists(os.path.join(x, d, "install.sh"))), None)
            if not inst: fail("the tarball has no install.sh")
            r = subprocess.run(["sh", inst, "--upgrade"], capture_output=True, text=True)
            if r.returncode != 0: fail("the installer stopped: " + (r.stderr or r.stdout)[-400:])
        else:
            r = subprocess.run(["apt-get", "install", "-y", "--allow-downgrades", os.path.join(work, deb)], capture_output=True, text=True)
            if r.returncode != 0: fail("apt couldn't install it: " + (r.stderr or r.stdout)[-400:])
        if keep:
            subprocess.run(["nova-app-publish", keep, f"Nova {pretty(ver)}"], capture_output=True)
            say("→ the matching app is ready in the in-app updater (Nova app → Settings → Software update)")
        status(state="done", current=installed_version(), available=ver, error="")
        say(f"✓ Nova {pretty(installed_version())} installed — settings and paired devices kept")
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    main()
