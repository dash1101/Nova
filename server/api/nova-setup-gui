function paint() {
  const last = step === STEPS.length - 1;
  $("#app").innerHTML = `<h1>Nova setup</h1><div class="dots">${STEPS.map((_, i) => `<i class="${i <= step ? "on" : ""}"></i>`).join("")}</div>${STEPS[step]()}
    <div class="row">${step ? `<button class="back" id="back">Back</button>` : "<span></span>"}<button class="go" id="next">${last ? "Set up Nova" : step ? "Next" : "Start"}</button></div>`;
  document.querySelectorAll("[data-k]").forEach(el => el.addEventListener(el.type === "checkbox" ? "change" : "input", () => A[el.dataset.k] = el.type === "checkbox" ? el.checked : el.value.trim()));
  $("#back")?.addEventListener("click", () => { step--; paint(); });
  $("#next").addEventListener("click", () => { if (step === 0 && (D.checks || []).some(c => c.level === "stop")) return alert("Fix the problem marked ✗ first, then reload this page.");
    if (step === 1 && !/^\d+\.\d+\.\d+\.\d+$/.test(A.lan_host || "")) return alert("That address doesn't look right — like 192.168.1.20"); last ? run() : (step++, paint()); });
  scrollTo(0, 0);
}
async function run() {
  const answers = { ...A }; if (!answers.discord_webhook) delete answers.discord_webhook; if (!answers.tunnel_token) delete answers.tunnel_token; if (!answers.location) delete answers.location;
  $("#app").innerHTML = `<h1>Setting up Nova</h1><p class="lead" id="st">Working…</p><div class="card"><pre id="log"></pre></div><div id="end"></div>`;
  await fetch(base + "/run", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ answers }) });
  let n = 0;
  const poll = async () => {
    const r = await (await fetch(base + "/log?from=" + n)).json(); n = r.n;
    const log = $("#log"); log.textContent += r.lines.map(l => l + "\n").join(""); log.scrollTop = log.scrollHeight;
    if (!r.done) return setTimeout(poll, 700);
    if (r.rc !== 0) { $("#st").innerHTML = `<span class="warn">Setup stopped — see the last lines above.</span> Fix it and run this again, or use <b>sudo nova-setup</b> in a terminal.`; return; }
    $("#st").innerHTML = `<span class="ok">✓ Nova is running.</span>`;
    const p = r.pair;
    $("#end").innerHTML = p ? `<h2>Pair your phone</h2><div class="card qr">${p.svg}<div><p>Open the Nova app on your home Wi-Fi and scan this — or type it in:</p>
      <p>Server <b>${esc(p.host)}</b><br>Code <span class="code">${esc(p.code)}</span><br><span class="badge">Certificate ${esc(p.pin)}</span></p><p class="hint">The code works once, for 10 minutes. Later: sudo nova add</p></div></div>
      <div class="row"><span></span><button class="go" id="fin">Done</button></div>` : `<p>Pair your phone with <b>sudo nova add</b>.</p>`;
    $("#fin")?.addEventListener("click", async () => { await fetch(base + "/finish", { method: "POST" }); $("#app").innerHTML = "<h1>All set</h1><p class='lead'>You can close this page. Browser: https://" + esc(A.lan_host) + ":8495/</p>"; });
  };
  poll();
}
(async () => { D = await (await fetch(base + "/detect")).json(); paint(); })();
