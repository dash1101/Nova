#!/usr/bin/python3
"""
nova-setup-gui — Nova's setup in a browser, for people who'd rather not use the shell.

    sudo nova-setup --gui           (or: sudo nova-setup-gui)

It prints one address with a one-time key in it (and opens it, if this computer has a desktop). Open it
on this computer or any device on your home network. The page asks the same questions as nova-setup,
then runs nova-setup with your answers and shows what it does, and finally the code to pair your phone.

Only the address with the key works, only from this computer or your home network, and it stops when
setup is done (or after an hour).
"""
import http.server, ipaddress, json, os, re, secrets, shutil, socket, subprocess, sys, tempfile, threading, time

if os.geteuid() != 0: sys.exit("Run with sudo:  sudo nova-setup --gui")
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = ["/usr/lib/nova-api", HERE]
SETUP = shutil.which("nova-setup") or os.path.join(HERE, "nova-setup")
NOVA = shutil.which("nova") or os.path.join(HERE, "nova")
KEY = secrets.token_urlsafe(18)
STATE = {"lines": [], "done": False, "rc": None, "running": False, "pair": None}
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
DEADLINE = time.time() + 3600


def sh(*cmd):
    try: r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    except (FileNotFoundError, subprocess.TimeoutExpired): return 127, ""
    return r.returncode, r.stdout.strip()

def lan_guess():
    _, out = sh("ip", "-4", "route", "get", "1.1.1.1")
    ip = re.search(r"src (\S+)", out); dev = re.search(r"dev (\S+)", out)
    if not ip: return "", ""
    _, a = sh("ip", "-4", "-o", "addr", "show", "dev", dev.group(1))
    cidr = re.search(r"inet (\S+)", a)
    return ip.group(1), str(ipaddress.ip_interface(cidr.group(1)).network) if cidr else ip.group(1) + "/32"

def detect():
    cfg = {}
    try: cfg = json.load(open("/etc/nova-api/config.json"))
    except Exception: pass
    ip, net = lan_guess()
    osname = ""
    try: osname = re.search(r'^PRETTY_NAME="?([^"\n]+)', open("/etc/os-release").read(), re.M).group(1)
    except Exception: pass
    try: import pkg; pm = pkg.which()
    except ImportError: pm = ""
    try:
        from storage import missing_packages, TOOLS
        miss = missing_packages(list(TOOLS))
    except ImportError: miss = []
    rc, ts = sh("tailscale", "ip", "-4")
    try: from nova_tz import tz_location; tzl = tz_location()
    except ImportError: tzl = None
    try: ac = json.load(open("/etc/nova-alerts/config.json"))
    except Exception: ac = {}
    return {"os": osname, "pm": pm, "hostname": socket.gethostname(), "configured": bool(cfg.get("lan_host")),
            "lan_host": cfg.get("lan_host") or ip, "lan_subnet": cfg.get("lan_subnet") or net,
            "tailscale": bool(shutil.which("tailscale")), "tailscale_ip": ts.splitlines()[0] if rc == 0 and ts else "",
            "cloudflared": bool(shutil.which("cloudflared")),
            "docker": bool(shutil.which("docker")), "missing_tools": miss,
            "firewall": "ufw" if sh("ufw", "status")[1].startswith("Status: active") else "firewalld" if sh("firewall-cmd", "--state")[1] == "running" else "",
            "ssh_user": cfg.get("ssh_user") or os.environ.get("SUDO_USER", ""), "discord": bool(ac.get("discord_webhook")),
            "near": tzl["name"] if tzl else "", "remote_url": cfg.get("remote_url", ""), "checks": _checks()}

def _checks():
    try: import preflight; return [c for c in preflight.checks() if c["level"] != "ok" or c["fix"]]
    except Exception: return []

def run_setup(answers):
    STATE.update(running=True, lines=[], done=False, rc=None)
    fd, path = tempfile.mkstemp(prefix="nova-answers-", suffix=".json"); os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w") as f: json.dump(answers, f)
    try:
        p = subprocess.Popen([sys.executable, SETUP, "--yes", "--answers", path], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                             env={**os.environ, "TERM": "dumb"}, stdin=subprocess.DEVNULL)
        for line in p.stdout:
            line = ANSI.sub("", line.rstrip())
            if line.strip(): STATE["lines"].append(line[:400])
        STATE["rc"] = p.wait()
    finally:
        os.remove(path)
    if STATE["rc"] == 0:
        rc, out = sh(NOVA, "add", "--json")
        try: STATE["pair"] = json.loads(out.splitlines()[-1])
        except (ValueError, IndexError): STATE["pair"] = None
    STATE.update(running=False, done=True)


class H(http.server.BaseHTTPRequestHandler):
    server_version = "nova-setup"; sys_version = ""
    def log_message(self, *a): pass

    def allowed(self):
        try: ip = ipaddress.ip_address(self.client_address[0])
        except ValueError: return False
        if ip.is_loopback: return True
        _, net = lan_guess()
        return bool(net) and ip in ipaddress.ip_network(net, strict=False)       # this computer, or your home network

    def reply(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else (json.dumps(body) if ctype == "application/json" else body).encode()
        self.send_response(code)
        for k, v in (("Content-Type", ctype + "; charset=utf-8"), ("Content-Length", str(len(data))), ("Cache-Control", "no-store"),
                     ("X-Frame-Options", "DENY"), ("Referrer-Policy", "no-referrer"), ("X-Content-Type-Options", "nosniff"),
                     ("Content-Security-Policy", "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'self'; base-uri 'none'; form-action 'none'")):
            self.send_header(k, v)
        self.end_headers(); self.wfile.write(data)

    def route(self):
        if not self.allowed() or time.time() > DEADLINE: return None
        m = re.fullmatch(r"/setup/([A-Za-z0-9_-]{20,40})(/[a-z]*)?", self.path.split("?")[0])
        if not m or not secrets.compare_digest(m.group(1), KEY): return None
        return m.group(2) or "/"

    def do_GET(self):
        r = self.route()
        if r is None: return self.reply(404, {"error": "not found"})
        if r == "/": return self.reply(200, PAGE, "text/html")
        if r == "/detect": return self.reply(200, detect())
        if r == "/log":
            n = int(re.search(r"from=(\d+)", self.path).group(1)) if "from=" in self.path else 0
            return self.reply(200, {"lines": STATE["lines"][n:], "n": len(STATE["lines"]), "done": STATE["done"], "rc": STATE["rc"], "pair": STATE["pair"]})
        self.reply(404, {"error": "not found"})

    def do_POST(self):
        r = self.route()
        if r is None: return self.reply(404, {"error": "not found"})
        if self.headers.get("Origin") and not self.headers["Origin"].endswith(f":{self.server.server_port}"): return self.reply(403, {"error": "wrong origin"})
        n = int(self.headers.get("Content-Length") or 0)
        if n > 64 * 1024: return self.reply(413, {"error": "too big"})
        try: body = json.loads(self.rfile.read(n) or b"{}")
        except ValueError: return self.reply(400, {"error": "bad request"})
        if r == "/run":
            if STATE["running"]: return self.reply(409, {"error": "setup is already running"})
            ans = {k: v for k, v in (body.get("answers") or {}).items() if re.fullmatch(r"[a-z_]{2,30}", str(k)) and isinstance(v, (str, bool, int))}
            threading.Thread(target=run_setup, args=(ans,), daemon=True).start()
            return self.reply(200, {"ok": True})
        if r == "/finish":
            self.reply(200, {"ok": True}); threading.Thread(target=lambda: (time.sleep(1), os._exit(0)), daemon=True).start(); return
        self.reply(404, {"error": "not found"})


