def main():
    sys.stdout.reconfigure(line_buffering=True)
    port = next((p for p in [*range(8490, 8495), *range(8497, 8500)] if socket.socket().connect_ex(("127.0.0.1", p)) != 0), 8490)
    srv = http.server.ThreadingHTTPServer(("0.0.0.0", port), H)
    ip, _ = lan_guess()
    local, lan = f"http://localhost:{port}/setup/{KEY}", f"http://{ip}:{port}/setup/{KEY}" if ip else ""
    print("\n  Nova setup is open in your browser:\n")
    print(f"    On this computer:     {local}")
    if lan: print(f"    From another device:  {lan}")
    _, ufw = sh("ufw", "status"); _, net = lan_guess()
    if lan and ufw.startswith("Status: active") and f"{port}" not in ufw:
        print(f"\n  Your firewall (ufw) keeps other devices out. To use another device:  sudo ufw allow from {net} to any port {port} proto tcp")
    print("\n  (The address has a one-time key in it. It stops when setup is done, or in an hour. Ctrl-C to stop.)\n")
    if os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"):
        u = os.environ.get("SUDO_USER")
        opener = shutil.which("xdg-open")
        if opener: subprocess.Popen((["runuser", "-u", u, "--"] if u else []) + [opener, local], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    threading.Thread(target=lambda: (time.sleep(max(0, DEADLINE - time.time())), os._exit(0)), daemon=True).start()
    try: srv.serve_forever()
    except KeyboardInterrupt: print("\n  Stopped.")


if __name__ == "__main__":
    main()
