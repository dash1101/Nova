#!/usr/bin/python3
"""
nova-api — manage devices allowed to use the Nova app.   (run with sudo)
  sudo nova-api pair [--minutes N] [--role admin|viewer] [--user NAME]
                                     show a one-time QR code to pair a phone (home Wi-Fi only)
  sudo nova-api devices              list paired devices
  sudo nova-api revoke <id|name>     remove a device (it can never connect again)
  sudo nova-api log [N]              last N actions from the audit log
"""
import hashlib, json, os, secrets, subprocess, sys, time
DATA = "/var/lib/nova-api"; DEVICES = f"{DATA}/devices.json"; PAIRING = f"{DATA}/pairing.json"
CFG = json.load(open("/etc/nova-api/config.json"))
def load(p, d):
    try: return json.load(open(p))
    except Exception: return d
def save(p, o):
    tmp = p + ".tmp"; json.dump(o, open(tmp, "w"), indent=1); os.chmod(tmp, 0o640)
    os.chown(tmp, *[__import__("pwd").getpwnam("nova-api")[i] for i in (2, 3)]); os.replace(tmp, p)

if os.geteuid() != 0: sys.exit("run with sudo")
cmd = sys.argv[1] if len(sys.argv) > 1 else "help"
if cmd == "pair":
    opt = dict(zip(sys.argv[2::2], sys.argv[3::2]))           # --minutes N  --role admin|viewer  --user NAME
    mins = int(opt.get("--minutes", 10))
    role = opt.get("--role", "admin")
    if role not in ("admin", "viewer"): sys.exit("--role must be admin or viewer")
    user = opt.get("--user", "")[:40]
    alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"            # no 0/O/1/I
    code = "".join(secrets.choice(alphabet) for _ in range(10))
    save(PAIRING, {"code_sha256": hashlib.sha256(code.encode()).hexdigest(), "expires": time.time() + mins * 60,
                   "role": role, "user": user})
    lan, pin = CFG["lan_url"], ""
    try:      # the encrypted home-network listener: the app pins this exact certificate
        from cryptography import x509
        from cryptography.hazmat.primitives import serialization
        der = x509.load_pem_x509_certificate(open(f"{DATA}/tls/cert.pem", "rb").read()).public_bytes(serialization.Encoding.DER)
        pin = hashlib.sha256(der).hexdigest()
        lan = f"https://{CFG.get('lan_host') or '127.0.0.1'}:{CFG.get('tls_port', 8495)}"
    except Exception:
        pass
    payload = json.dumps({"nova": 1, "lan": lan, "pin": pin, "remote": CFG.get("remote_url", ""), "code": code},
                         separators=(",", ":"))
    subprocess.run(["qrencode", "-t", "ANSIUTF8", "-m", "2", payload])
    print(f"\nScan this with the Nova app on your HOME Wi-Fi.  Code: {code}  (single use, expires in {mins} min)")
    print(f"The phone will be: {'Admin (full control)' if role == 'admin' else 'View only'}" + (f", user {user}" if user else ""))
    if pin: print(f"Typing it instead? Server address: {lan.split('//')[1]}   Certificate: {pin[:4].upper()} {pin[4:8].upper()} {pin[8:12].upper()}")
elif cmd == "devices":
    devs = load(DEVICES, {})
    if not devs: print("no paired devices")
    for k, d in devs.items():
        print(f"{k}  {d['name']:<24} {d.get('role', 'admin'):<6} {d.get('user', '') or '-':<12} paired {d['created']}  last seen {d.get('last_seen','never')} via {d.get('last_via','-')}"
              + ("  [REVOKED]" if d.get("revoked") else ""))
elif cmd == "revoke" and len(sys.argv) > 2:
    devs = load(DEVICES, {}); hit = [k for k, d in devs.items() if sys.argv[2] in (k, d["name"])]
    for k in hit: devs.pop(k)
    save(DEVICES, devs); print("revoked:", hit or "nothing matched")
elif cmd == "log":
    n = int(sys.argv[2]) if len(sys.argv) > 2 else 20
    for l in open("/var/log/nova-api/audit.log").readlines()[-n:]: print(l.rstrip())
else:
    print(__doc__)
