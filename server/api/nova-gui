#!/usr/bin/python3
"""
nova-gui — the Nova Server window: what `nova` does in a terminal, for servers that have a screen.

    nova gui            (from the app menu / Start menu: "Nova Server")
    nova gui --pair     …and go straight to pairing a phone

It shows whether Nova is running and how the server is doing, pairs a phone with a QR code, lists and removes
devices, approves browsers and actions that are waiting, runs the check-up, and starts or stops Nova. The same
window on Linux and Windows.

How it works: a small page served on this computer only (127.0.0.1), opened in its own window. The part that does
the work needs administrator rights, so the desktop asks for your password (Linux) or shows the usual Windows
prompt once when it opens. Every request needs a one-time key that only the opened window has, and the window's
address never leaves this computer. It stops by itself a little after the window is closed.

    nova-gui --serve --print-url     (what the launcher runs with administrator rights; prints the address)
"""
import http.server, importlib.machinery, importlib.util, json, os, re, secrets, shutil, socket, subprocess, sys, tempfile, threading, time

HERE = os.path.dirname(os.path.realpath(__file__))
LIB = "/usr/lib/nova-api" if os.path.isdir("/usr/lib/nova-api") else HERE
sys.path[:0] = [LIB, HERE]
import plat  # noqa: E402

WIN = plat.WINDOWS
NOVA = next((p for p in (os.path.join(HERE, "nova"), shutil.which("nova") or "", "/usr/bin/nova") if p and os.path.isfile(p)), "nova")
KEY = secrets.token_urlsafe(24)
LAST = {"t": time.time()}                       # when the window last asked for something
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
NO_WINDOW = 0x08000000 if WIN else 0


def cli():
    """The `nova` command's own functions (one implementation for the terminal and this window)."""
    if "nova_cli" not in sys.modules:
        loader = importlib.machinery.SourceFileLoader("nova_cli", NOVA)
        spec = importlib.util.spec_from_loader("nova_cli", loader); mod = importlib.util.module_from_spec(spec)
        sys.modules["nova_cli"] = mod; loader.exec_module(mod)
    return sys.modules["nova_cli"]

def is_admin():
    if WIN:
        import winhost
        return winhost.is_admin()
    return os.geteuid() == 0

def nova(*args, timeout=90):
    """Run `nova …` → (rc, text) with the colors taken out."""
    try:
        r = subprocess.run([sys.executable, NOVA, *args], capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=timeout,
                           stdin=subprocess.DEVNULL, creationflags=NO_WINDOW, env={**os.environ, "PYTHONIOENCODING": "utf-8"})
        return r.returncode, ANSI.sub("", (r.stdout + ("\n" + r.stderr if r.stderr.strip() else "")).replace("\r", "\n")).strip()
    except subprocess.TimeoutExpired: return 124, "It took too long."

def load(p, d):
    try:
        with open(p, encoding="utf-8") as f: return json.load(f)
    except Exception: return d

PARTS = (("api", "Nova", "nova-api.service", "Api"), ("helper", "Helper", "nova-helper.socket", "Helper"), ("alerts", "Monitor", "nova-alerts.timer", "Alerts"))
_parts = {"t": 0, "v": []}
def parts():
    """Nova's parts and whether each is running (asked at most every 3 s — on Windows each question costs a moment)."""
    if time.time() - _parts["t"] < 3: return _parts["v"]
    out = []
    for pid, name, unit, task in PARTS:
        if WIN:
            import winhost
            st = winhost.task_state(task)
        else:
            st = subprocess.run(["systemctl", "is-active", unit], capture_output=True, text=True).stdout.strip()
            if st not in ("active",): st = "missing" if subprocess.run(["systemctl", "cat", unit], capture_output=True).returncode != 0 else "inactive"
        out.append({"id": pid, "name": name, "state": st})
    _parts.update(t=time.time(), v=out)
    return out

def state():
    c = cli(); now = time.time()
    cfg = load(c.CONFIG, {}); devs = load(c.DEVICES, {}); pend = load(c.PENDING, {}); pairing = load(c.PAIRING, {})
    st = load(plat.p("/var/lib/nova-alerts/www/status.json"), {})
    kinds = lambda d: ({"watch": "Watch", "head": "Another Nova server"}.get(d.get("type")) or
                       ("Browser" if d.get("type") == "browser" else {"tablet": "Tablet", "desktop": "Computer", "watch": "Watch"}.get(d.get("form"), "Phone")))
    ps = parts(); tls = cfg.get("tls_port", 8495); host = cfg.get("lan_host", "")
    return {
        "version": c.version().replace("~", "-"), "os": plat.os_name(), "host": plat.node(), "windows": WIN, "configured": bool(host),
        "parts": ps, "running": any(p["id"] == "api" and p["state"] == "active" for p in ps),
        "addresses": [a for a in (
            {"label": "On your home network", "url": f"https://{host}:{tls}", "note": "encrypted; what the Nova app uses"} if host else None,
            {"label": "On this computer", "url": f"http://127.0.0.1:{cfg.get('port', 8095)}", "note": ""} if host else None,
            {"label": "Over Tailscale", "url": f"https://{cfg['tailnet_host']}:{tls}", "note": ""} if cfg.get("tailnet_host") else None,
            {"label": "From anywhere", "url": cfg["remote_url"], "note": "through your Cloudflare tunnel"} if cfg.get("remote_url") else None) if a],
        "host_ip": host, "pin": c.short_pin(c.my_pin()),
        "devices": [{"id": k, "name": d.get("name", "?"), "kind": kinds(d), "role": "Admin" if d.get("role", "admin") == "admin" else "View only",
                     "user": d.get("user") or "", "seen": d.get("last_seen") or "", "via": d.get("last_via") or "", "created": d.get("created", "")}
                    for k, d in sorted(devs.items(), key=lambda kv: kv[1].get("created", ""))],
        "waiting": [{"code": b["code"], "kind": "browser", "what": (f"Let the Nova server “{b['name']}” show this one (read-only)" if b.get("kind") == "head" else f"Add the browser “{b['name']}”"),
                     "who": f"from {b.get('from', '?')}", "left": int(b["expires"] - now)} for b in pend.get("browsers", []) if b.get("expires", 0) > now] +
                   [{"code": a["code"], "kind": "action", "what": a.get("what", ""), "who": f"asked by {a.get('device', '?')}", "left": int(a["expires"] - now)}
                    for a in pend.get("approvals", []) if a.get("expires", 0) > now],
        "pairing": {"active": bool(pairing) and pairing.get("expires", 0) > now, "left": max(0, int(pairing.get("expires", 0) - now))},
        "health": {"level": st.get("level", ""), "headline": st.get("headline", ""), "updated": st.get("updated_local", ""),
                   "active": [{"level": a.get("level"), "title": a.get("title", ""), "detail": a.get("detail", ""), "since": a.get("since", "")}
                              for a in st.get("active", []) if a.get("level") in ("info", "warning", "critical")][:12]} if st else None,
    }

def service(action):
    if action not in ("start", "stop", "restart"): return {"ok": False, "error": "bad action"}
    if WIN:
        import winhost
        stop = "Stop-ScheduledTask -TaskPath '\\Nova\\' -TaskName 'Api';"
        start = "foreach($t in 'Helper','Api','Alerts'){ if((Get-ScheduledTask -TaskPath '\\Nova\\' -TaskName $t).State -ne 'Running'){ Start-ScheduledTask -TaskPath '\\Nova\\' -TaskName $t } };"
        rc, so, se = winhost.ps({"start": start, "stop": stop, "restart": stop + "Start-Sleep 1;" + start}[action], 60)
    else:
        units = ["nova-api.service"] if action != "start" else ["nova-helper.socket", "nova-api.service"]
        r = subprocess.run(["systemctl", action, *units], capture_output=True, text=True, timeout=60); rc, se = r.returncode, r.stderr
    _parts["t"] = 0
    return {"ok": rc == 0, "error": (se or "").strip()[-300:] if rc else ""}

def doctor():
    import guides
    found = guides.doctor()
    if not WIN:
        try:
            import preflight
            found += [{"level": c["level"], "title": c["title"], "fix": c["fix"]} for c in preflight.checks() if c["level"] != "ok"]
        except Exception: pass
    if WIN: found = [{**c, "fix": c.get("fix", "").replace("sudo nova", "nova")} for c in found]
    return {"checks": found}

def pair(d):
    args = ["add", "--json", "--minutes", str(min(60, max(2, int(d.get("minutes") or 10))))]
    if d.get("viewer"): args.append("--viewer")
    if d.get("remote"): args.append("--remote")
    user = "".join(ch for ch in str(d.get("user") or "") if ch.isprintable())[:40]
    if user: args += ["--user", user]
    rc, out = nova(*args)
    try: r = json.loads(out.splitlines()[0])
    except (ValueError, IndexError): return {"ok": False, "error": out[-300:] or "couldn't make a code"}
    import qrgen
    try: r["svg"] = qrgen.svg(r.pop("payload"), border=3)
    except Exception: r.pop("payload", None)
    return {"ok": True, **r}

def activity(n=25):
    try:
        with open(plat.p("/var/log/nova-api/audit.log"), encoding="utf-8", errors="replace") as f: lines = f.readlines()[-400:]
    except OSError: return {"lines": []}
    out = []
    for l in reversed(lines):
        try: e = json.loads(l)
        except ValueError: continue
        if e.get("method") in (None, "GET") and e.get("path") != "/api/v1/pair": continue          # what was done, not what was looked at
        out.append({"t": e.get("time") or e.get("t") or "", "who": e.get("device") or e.get("ip") or "", "what": f"{e.get('method', '')} {e.get('path', '')}".strip(),
                    "ok": str(e.get("result", e.get("status", ""))).startswith("2")})
        if len(out) >= n: break
    return {"lines": out}


class H(http.server.BaseHTTPRequestHandler):
    server_version = "nova-gui"; sys_version = ""
    def log_message(self, *a): pass

    def reply(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else (json.dumps(body) if ctype == "application/json" else body).encode()
        self.send_response(code)
        for k, v in (("Content-Type", ctype + "; charset=utf-8"), ("Content-Length", str(len(data))), ("Cache-Control", "no-store"),
                     ("X-Frame-Options", "DENY"), ("Referrer-Policy", "no-referrer"), ("X-Content-Type-Options", "nosniff"),
                     ("Content-Security-Policy", "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'")):
            self.send_header(k, v)
        self.end_headers(); self.wfile.write(data)

    def ok(self):
        """This computer, asking for this window by name (not a web page somewhere else pointing a name at 127.0.0.1), with the key."""
        import hmac
        host = (self.headers.get("Host") or "").rsplit(":", 1)[0]
        return (self.client_address[0] in ("127.0.0.1", "::1") and host in ("localhost", "127.0.0.1") and
                hmac.compare_digest(self.headers.get("X-Nova-Key") or "", KEY))

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path == "/": return self.reply(200, PAGE, "text/html")
        if path == "/icon.svg":
            for d in (os.path.join(LIB, "web"), os.path.join(HERE, "web"), os.path.join(HERE, "..", "web")):
                if os.path.exists(os.path.join(d, "icon.svg")): return self.reply(200, open(os.path.join(d, "icon.svg"), "rb").read(), "image/svg+xml")
            return self.reply(404, b"", "text/plain")
        if not self.ok(): return self.reply(403, {"error": "this window's key is missing — open Nova Server again"})
        LAST["t"] = time.time()
        try:
            if path == "/api/state": return self.reply(200, state())
            if path == "/api/doctor": return self.reply(200, doctor())
            if path == "/api/activity": return self.reply(200, activity())
        except Exception as e: return self.reply(500, {"error": repr(e)[:300]})
        self.reply(404, {"error": "not found"})

    def do_POST(self):
        if not self.ok(): return self.reply(403, {"error": "this window's key is missing — open Nova Server again"})
        LAST["t"] = time.time()
        try:
            n = int(self.headers.get("Content-Length") or 0)
            d = json.loads(self.rfile.read(n) or b"{}") if 0 < n <= 65536 else {}
            c = cli(); path = self.path.split("?", 1)[0]
            if path == "/api/pair": return self.reply(200, pair(d))
            if path == "/api/pair/cancel":
                try: os.remove(c.PAIRING)
                except OSError: pass
                return self.reply(200, {"ok": True})
            if path == "/api/approve":
                code = re.sub(r"[^A-Za-z0-9-]", "", str(d.get("code", "")))[:24]
                if not code: return self.reply(200, {"ok": False, "error": "Type the code the browser shows."})
                rc, out = nova("approve", code, *(["--viewer"] if d.get("viewer") else []), timeout=70)
                return self.reply(200, {"ok": rc == 0 and "Done" in out, "error": "" if rc == 0 and "Done" in out else (out.splitlines() or ["That didn't work."])[-1].strip()[:300]})
            if path == "/api/remove":
                did = str(d.get("id", ""))
                if did not in load(c.DEVICES, {}): return self.reply(200, {"ok": False, "error": "That device is already gone."})
                rc, out = nova("remove", did)
                return self.reply(200, {"ok": rc == 0, "error": "" if rc == 0 else out[-300:]})
            if path == "/api/service": return self.reply(200, service(str(d.get("action", ""))))
            if path == "/api/test-alert":
                rc, out = nova("alert", "info", "Test from the Nova Server window", "If you can read this on your phone, alerts work.")
                return self.reply(200, {"ok": rc == 0, "error": "" if rc == 0 else out[-300:]})
            if path == "/api/update-check":
                if WIN: return self.reply(200, {"ok": True, "message": "To update Nova on Windows, download the newest release and run its installer again — your settings and paired devices stay."})
                rc, out = nova("update", "--check", timeout=200)
                return self.reply(200, {"ok": rc == 0, "message": out[-600:]})
            if path == "/api/network":                       # the server's address changed (new router): look again, then restart Nova
                if not WIN: return self.reply(200, {"ok": False, "error": "On Linux this is part of setup: Set up Nova in the app menu, or sudo nova setup."})
                r = subprocess.run([sys.executable, os.path.join(HERE, "winsetup.py"), "--refresh"], capture_output=True, text=True, creationflags=NO_WINDOW, timeout=60)
                if r.returncode != 0: return self.reply(200, {"ok": False, "error": (r.stderr or r.stdout)[-300:]})
                return self.reply(200, {**service("restart"), "found": json.loads(r.stdout.strip().splitlines()[-1])})
            if path == "/api/quit":
                self.reply(200, {"ok": True}); threading.Thread(target=lambda: (time.sleep(.3), os._exit(0)), daemon=True).start(); return
        except Exception as e: return self.reply(500, {"error": repr(e)[:300]})
        self.reply(404, {"error": "not found"})


def watchdog():
    """Stop a little after the window is gone (it asks for the state every few seconds while open), or after 12 hours."""
    start = time.time()
    while True:
        time.sleep(5)
        if time.time() - LAST["t"] > 75 or time.time() - start > 12 * 3600: os._exit(0)

def serve(print_url=False, url_file="", start=""):
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), H); srv.daemon_threads = True
    url = f"http://localhost:{srv.server_address[1]}/{'?do=pair' if start == 'pair' else ''}#{KEY}"
    if url_file:
        with open(url_file, "w") as f: f.write(url)
    if print_url and not WIN:
        if os.fork():                                   # the launcher gets the address; the window's server carries on by itself
            print(url, flush=True); os._exit(0)
        os.setsid(); fd = os.open(os.devnull, os.O_RDWR)
        for n in (0, 1, 2): os.dup2(fd, n)
    elif print_url: print(url, flush=True)
    threading.Thread(target=watchdog, daemon=True).start()
    return srv, url

def app_window(url):
    """Open the address in its own window (a Chromium-family browser's app mode) or, failing that, the default browser.
    Runs as the person at the screen, never as administrator."""
    cands = []
    if WIN:
        for base in (os.environ.get("ProgramFiles(x86)"), os.environ.get("ProgramFiles"), os.environ.get("LocalAppData")):
            if base: cands += [os.path.join(base, "Microsoft", "Edge", "Application", "msedge.exe"), os.path.join(base, "Google", "Chrome", "Application", "chrome.exe")]
    else:
        cands = [shutil.which(n) for n in ("chromium", "chromium-browser", "google-chrome", "google-chrome-stable", "brave-browser", "microsoft-edge", "vivaldi")]
    exe = next((c for c in cands if c and os.path.exists(c)), None)
    try:
        if exe:
            subprocess.Popen([exe, f"--app={url}", "--window-size=1040,820"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL); return True
        if WIN: os.startfile(url); return True
        opener = shutil.which("xdg-open") or shutil.which("gio")
        if opener:
            subprocess.Popen([opener, url] if opener.endswith("xdg-open") else [opener, "open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL); return True
    except OSError: pass
    return False

def launcher():
    """Not an administrator: start the working part with administrator rights (the desktop asks), then open the window as you."""
    if WIN:
        import ctypes
        fd, uf = tempfile.mkstemp(prefix="nova-gui-", suffix=".url"); os.close(fd)
        exe = sys.executable if sys.executable.lower().endswith("pythonw.exe") else os.path.join(os.path.dirname(sys.executable), "pythonw.exe")
        if not os.path.exists(exe): exe = sys.executable
        rc = ctypes.windll.shell32.ShellExecuteW(None, "runas", exe, f'"{os.path.realpath(__file__)}" --serve --url-file "{uf}"' + (" --pair" if "--pair" in sys.argv else ""), None, 0)
        if rc <= 32: return 1                              # the prompt was declined
        url = ""
        for _ in range(150):
            time.sleep(.2)
            try: url = open(uf).read().strip()
            except OSError: url = ""
            if url.startswith("http://localhost:"): break
        try: os.remove(uf)
        except OSError: pass
    else:
        if not shutil.which("pkexec"): sys.exit("Run it with sudo:  sudo nova gui")
        r = subprocess.run(["pkexec", "/usr/sbin/nova-gui", "--serve", "--print-url"] + (["--pair"] if "--pair" in sys.argv else []), capture_output=True, text=True)
        url = r.stdout.strip().splitlines()[-1] if r.returncode == 0 and r.stdout.strip() else ""
    if not url.startswith("http://localhost:"): return 1
    app_window(url); return 0

def main():
    a = sys.argv[1:]
    if "--serve" not in a and not is_admin(): sys.exit(launcher())
    if not is_admin(): sys.exit("The Nova Server window needs administrator rights." if WIN else "Run it with sudo:  sudo nova gui")
    uf = a[a.index("--url-file") + 1] if "--url-file" in a and a.index("--url-file") + 1 < len(a) else ""
    srv, url = serve("--print-url" in a, uf, "pair" if "--pair" in a else "")
    if "--serve" not in a:                                 # started from an administrator terminal: open the window for whoever is at the screen
        print(f"\n  Nova Server is open in a window. If it didn't appear, open:\n\n    {url}\n\n  (Close the window, or press Ctrl-C here, to stop.)\n", flush=True)
        if WIN: subprocess.Popen(["explorer.exe", url])    # explorer opens it as you, not as administrator
        elif os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"):
            u = os.environ.get("SUDO_USER"); opener = shutil.which("xdg-open")
            if opener: subprocess.Popen((["runuser", "-u", u, "--"] if u else []) + [opener, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try: srv.serve_forever()
    except KeyboardInterrupt: pass


