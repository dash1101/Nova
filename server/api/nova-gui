.kv{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;margin:10px 0}.kv dt{color:var(--sub)}.kv dd{margin:0;font-weight:650;font-variant-numeric:tabular-nums;word-break:break-all}
.big{font:700 26px/1.1 ui-monospace,"Cascadia Mono",Menlo,monospace;letter-spacing:.12em}
.bar{height:6px;border-radius:3px;background:var(--soft);overflow:hidden;margin-top:10px}.bar i{display:block;height:100%;background:var(--blue);border-radius:3px;transition:width 1s linear}
input[type=text]{font:inherit;color:var(--text);background:var(--soft);border:0;border-radius:12px;padding:9px 12px;min-width:0}
label.chk{display:inline-flex;gap:7px;align-items:center;color:var(--sub);font-size:14px;cursor:pointer}
a{color:var(--blue);text-decoration:none}a:hover{text-decoration:underline}
.alert{display:flex;gap:10px;padding:9px 0;border-top:1px solid var(--line)}.alert:first-child{border-top:0}
.msg{margin-top:10px;padding:10px 12px;border-radius:12px;background:var(--soft);font-size:14px;white-space:pre-wrap}.msg.err{color:var(--red)}.msg.good{color:var(--green)}
.fix{color:var(--sub);font-size:13px;margin-top:2px}.mono{font-family:ui-monospace,"Cascadia Mono",Menlo,monospace;font-size:13px}
.fade{animation:fade .25s ease}@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.fade{animation:none}.bar i{transition:none}}
footer{display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between;color:var(--sub);font-size:13px;padding:0 4px}
</style></head><body><main id="app"><div class="card"><div class="empty">Opening…</div></div></main>
<script>
const KEY = location.hash.slice(1); let AUTO = new URLSearchParams(location.search).get("do"); history.replaceState(null, "", location.pathname);
const $ = (s, r = document) => r.querySelector(s);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
// "2026-11-10 20:16" → "today 20:16" / "yesterday" / "5 days ago" / "4 weeks ago"
const ago = st => { const t = Date.parse((st || "").replace(" ", "T")); if (!t) return st || "";
  const d = (Date.now() - t) / 864e5, today = new Date().toLocaleDateString("sv");      // (sv: YYYY-MM-DD, in local time)
  return st.slice(0, 10) === today ? "today " + st.slice(11, 16) : d < 2 ? "yesterday" : d < 14 ? Math.floor(d) + " days ago" : d < 30 ? Math.floor(d / 7) + " weeks ago" : d < 60 ? "a month ago" : Math.floor(d / 30) + " months ago"; };
const quiet = st => { const t = Date.parse((st || "").replace(" ", "T")); return t && Date.now() - t > 30 * 864e5; };
const clock = s => { s = Math.max(0, Math.round(s)); return Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0"); };
async function api(path, body) {
  const r = await fetch(path, { method: body === undefined ? "GET" : "POST", headers: { "X-Nova-Key": KEY, "Content-Type": "application/json" }, body: body === undefined ? undefined : JSON.stringify(body) });
  return r.json();
}
let S = null, pair = null, pairedName = "", known = null, busy = {}, note = {}, doc = null, act = null, confirmRm = "", gone = false, typed = "", opts = { viewer: false, remote: false };

function header() {
  const st = !S.configured ? ["warn", "Not set up yet"] : S.running ? ["ok", "Running"] : ["bad", "Stopped"];
  const others = S.parts.filter(p => p.id !== "api" && p.state !== "active" && p.state !== "missing");
  return `<header><img src="/icon.svg" alt=""><div class="grow"><h1>Nova Server</h1><div class="sub">${esc(S.host)} · Nova ${esc(S.version)} · ${esc(S.os)}</div></div>
    <span class="pill"><span class="dot ${st[0]}"></span>${st[1]}</span>
    <span class="btns">${S.running ? `<button data-do="svc" data-a="restart" ${busy.svc ? "disabled" : ""}>Restart</button><button data-do="svc" data-a="stop" ${busy.svc ? "disabled" : ""}>Stop</button>`
      : `<button class="pri" data-do="svc" data-a="start" ${busy.svc || !S.configured ? "disabled" : ""}>Start Nova</button>`}</span></header>
    ${note.svc ? `<div class="msg err">${esc(note.svc)}</div>` : ""}
    ${!S.configured ? `<div class="card"><h2>Finish setting up</h2><div class="sub">${S.windows ? "Run the Nova installer again — it writes the settings this needs." : "Open “Set up Nova” from the app menu, or run <span class=mono>sudo nova setup</span> in a terminal."}</div></div>` : ""}
    ${S.running && others.length ? `<div class="card"><div class="alert"><span class="dot warn" style="margin-top:6px"></span><div><div class="t">${others.map(p => esc(p.name)).join(" and ")} ${others.length > 1 ? "aren't" : "isn't"} running</div><div class="fix">Press Restart to bring every part back.</div></div></div></div>` : ""}`;
}
function health() {
  const h = S.health; if (!h || !S.configured) return "";
  const lv = { ok: "ok", warning: "warn", critical: "bad" }[h.level] || "";
  return `<div class="card"><div style="display:flex;gap:10px;align-items:center"><span class="dot ${lv}"></span><h2 style="margin:0">${esc(h.headline || "No status yet")}</h2><span class="grow"></span><span class="sub">${h.updated ? "checked " + esc(h.updated) : ""}</span></div>
    ${h.active.length ? `<div style="margin-top:10px">${h.active.map(a => `<div class="alert"><span class="dot ${a.level === "critical" ? "bad" : a.level === "warning" ? "warn" : ""}" style="margin-top:6px"></span><div><div class="t">${esc(a.title)}</div>${a.detail ? `<div class="fix">${esc(a.detail)}</div>` : ""}</div><span class="grow"></span><span class="sub" style="white-space:nowrap">${esc(a.since)}</span></div>`).join("")}</div>` : ""}</div>`;
}
function pairing() {
  if (!S.configured) return "";
  let body;
  if (pairedName) body = `<div class="fade"><div style="display:flex;gap:10px;align-items:center;margin:6px 0 12px"><span class="dot ok"></span><b>Paired: ${esc(pairedName)}</b></div><button data-do="pair-done">Done</button> <button data-do="pair">Pair another</button></div>`;
  else if (pair && S.pairing.active) {
    const left = pair.expires - Date.now() / 1000, total = pair.total || 600;
    body = `<div class="qr fade"><div class="code">${pair.svg || ""}</div><div>
      <div class="sub">${pair.remote ? "Scan with the Nova app from anywhere." : "Scan with the Nova app on your home Wi-Fi — or type these in:"}</div>
      <dl class="kv"><dt>Server address</dt><dd>${esc(pair.host)}</dd><dt>Code</dt><dd class="big">${esc(pair.code)}</dd><dt>Certificate</dt><dd>${esc(pair.pin)}</dd>
      <dt>It will be</dt><dd>${pair.role === "viewer" ? "View only" : "an Admin (full control)"} · single use</dd></dl>
      ${pair.remote && pair.setup ? `<div class="sub">Or paste this into the app's “Away from home” box (keep it private):</div><div class="msg mono" style="word-break:break-all;user-select:all">${esc(pair.setup)}</div>` : ""}
      <div class="sub" id="left">Waiting for the phone… ${clock(left)} left</div><div class="bar"><i id="leftbar" style="width:${Math.max(0, 100 * left / total)}%"></i></div>
      <div style="margin-top:12px"><button data-do="pair-cancel">Cancel</button></div></div></div>`;
  } else body = `<div class="btns" style="align-items:center"><button class="pri" data-do="pair" ${busy.pair || !S.running ? "disabled" : ""}>Pair a phone or tablet</button>
      <label class="chk"><input type="checkbox" data-opt="viewer" ${opts.viewer ? "checked" : ""}> View only</label>
      <label class="chk"><input type="checkbox" data-opt="remote" ${opts.remote ? "checked" : ""}> It's away from home</label></div>
      ${!S.running ? `<div class="fix" style="margin-top:8px">Start Nova first.</div>` : ""}${note.pair ? `<div class="msg err">${esc(note.pair)}</div>` : ""}`;
  return `<div class="card"><h2>Pair a device</h2><div class="sub">Get the Nova app on your phone, tap “Add a server”, and scan the code.</div>${body}</div>`;
}
function waiting() {
  if (!S.configured) return "";
  const rows = S.waiting.map(w => `<div class="row fade"><div class="grow"><div class="t">${esc(w.what)}</div><div class="s">${esc(w.who)} · code <b class="mono">${esc(w.code)}</b> · ${clock(w.left)} left</div></div>
      <span class="btns">${w.kind === "browser" ? `<button class="small" data-do="approve" data-code="${esc(w.code)}" data-viewer="1" ${busy["ap" + w.code] ? "disabled" : ""}>View only</button>` : ""}
      <button class="small pri" data-do="approve" data-code="${esc(w.code)}" ${busy["ap" + w.code] ? "disabled" : ""}>${busy["ap" + w.code] ? "Approving…" : "Approve"}</button></span></div>`).join("");
  return `<div class="card"><h2>Waiting for approval</h2><div class="sub">A browser that wants in shows a code; so does an action a browser can't approve by itself.</div>
    ${rows || `<div class="empty">Nothing is waiting.</div>`}
    <div class="row"><input type="text" id="code" class="grow mono" placeholder="Or type a code" maxlength="24" value="${esc(typed)}" autocomplete="off" spellcheck="false">
      <button class="small" data-do="approve-typed" ${busy.aptyped ? "disabled" : ""}>${busy.aptyped ? "Approving…" : "Approve"}</button></div>
    ${note.approve ? `<div class="msg ${note.approveOk ? "good" : "err"}">${esc(note.approve)}</div>` : ""}</div>`;
}
function devices() {
  if (!S.configured) return "";
  const rows = S.devices.map(d => `<div class="row"><div class="grow"><div class="t">${esc(d.name)} <span class="tag">${esc(d.kind)}</span> <span class="tag">${esc(d.role)}</span>${d.user ? ` <span class="tag">${esc(d.user)}</span>` : ""}</div>
      <div class="s">${d.seen ? "last seen " + esc(ago(d.seen)) + (d.via ? " via " + esc(d.via) : "") : "never connected yet"}${quiet(d.seen) ? ` <span class="tag" style="color:var(--amber)">quiet for over a month</span>` : ""}</div></div>
      ${confirmRm === d.id ? `<span class="btns"><button class="small danger" data-do="rm-yes" data-id="${esc(d.id)}" ${busy.rm ? "disabled" : ""}>Remove — it can never connect again</button><button class="small" data-do="rm-no">Keep</button></span>`
        : `<button class="small" data-do="rm" data-id="${esc(d.id)}">Remove</button>`}</div>`).join("");
  return `<div class="card"><h2>Devices</h2><div class="sub">${S.devices.length ? S.devices.length + " paired" : "Phones, tablets, watches and browsers that can use this server."}</div><div class="scroll">${rows || `<div class="empty">No devices yet.</div>`}</div>${note.rm ? `<div class="msg err">${esc(note.rm)}</div>` : ""}</div>`;
}
function addresses() {
  if (!S.configured) return "";
  return `<div class="card"><h2>Where to find it</h2><div class="sub">Open Nova in a browser, or give the app this address.</div>
    ${S.addresses.map(a => `<div class="row"><div class="grow"><div class="t">${esc(a.label)}</div><div class="s">${a.note ? esc(a.note) : ""}</div></div><a class="mono" href="${esc(a.url)}" target="_blank" rel="noopener">${esc(a.url)}</a></div>`).join("")}
    <div class="row"><div class="grow"><div class="t">Certificate</div><div class="s">what phones and other servers check when they pair</div></div><span class="mono">${esc(S.pin)}</span></div>
    ${S.windows ? `<div class="row"><div class="grow"><div class="t">Address changed?</div><div class="s">after a new router, look at the network again</div></div><button class="small" data-do="network" ${busy.network ? "disabled" : ""}>${busy.network ? "Looking…" : "Look again"}</button></div>` : ""}
    ${note.network ? `<div class="msg ${note.networkOk ? "good" : "err"}">${esc(note.network)}</div>` : ""}</div>`;
}
function checkup() {
  const mark = { ok: "ok", warn: "warn", stop: "bad" };
  return `<div class="card"><div style="display:flex;align-items:center;gap:10px"><div class="grow"><h2>Check-up</h2><div class="sub" style="margin:0">Finds what's wrong and says how to fix it.</div></div>
    <button data-do="doctor" ${busy.doctor ? "disabled" : ""}>${busy.doctor ? "Checking…" : doc ? "Check again" : "Run it"}</button></div>
    ${doc ? `<div style="margin-top:10px" class="fade">${doc.map(c => `<div class="alert"><span class="dot ${mark[c.level] || ""}" style="margin-top:6px"></span><div><div class="t">${esc(c.title)}</div>${c.fix ? `<div class="fix">→ ${esc(c.fix)}</div>` : ""}</div></div>`).join("") || `<div class="empty">Nothing to report.</div>`}</div>` : ""}</div>`;
}
function more() {
  return `<div class="card"><h2>More</h2><div class="btns" style="margin-top:10px">
      <button data-do="update" ${busy.update ? "disabled" : ""}>${busy.update ? "Checking…" : "Check for updates"}</button>
      <button data-do="test" ${busy.test || !S.running ? "disabled" : ""}>Send a test alert</button>
      <button data-do="activity">${act ? "Hide recent activity" : "Recent activity"}</button></div>
    ${note.more ? `<div class="msg">${esc(note.more)}</div>` : ""}
    ${act ? `<div style="margin-top:10px" class="fade">${act.map(l => `<div class="row"><span class="dot ${l.ok ? "ok" : "warn"}"></span><div class="grow"><div class="t mono">${esc(l.what)}</div><div class="s">${esc(l.who)}</div></div><span class="sub">${esc(l.t)}</span></div>`).join("") || `<div class="empty">Nothing has been done from the app yet.</div>`}</div>` : ""}</div>`;
}
function paint() {
  if (gone) { $("#app").innerHTML = `<div class="card"><h2>Nova Server has closed</h2><div class="sub">Open it again from the ${S && S.windows ? "Start menu" : "app menu"}.</div></div>`; return; }
  const sc = $(".scroll") ? $(".scroll").scrollTop : 0;
  const keep = document.activeElement && document.activeElement.id === "code" ? [document.activeElement.selectionStart, document.activeElement.selectionEnd] : null;
  $("#app").innerHTML = header() + health() + `<div class="cols"><div class="col">${pairing()}${waiting()}</div><div class="col">${devices()}</div></div>` + addresses() + checkup() + more() +
    `<footer><span>This window talks only to this computer.</span><span>In a terminal: <span class="mono">${S.windows ? "" : "sudo "}nova help</span></span></footer>`;
  if (keep) { const i = $("#code"); i.focus(); i.setSelectionRange(keep[0], keep[1]); }
  if (sc && $(".scroll")) $(".scroll").scrollTop = sc;
}
async function refresh() {
  try { S = await api("/api/state"); if (S.error) throw 0; } catch (e) { if (S) { gone = true; paint(); } return; }
  if (known && pair && !pairedName) {                       // a device that wasn't there when the code was made: that's the one
    const nu = S.devices.find(d => !known.has(d.id));
    if (nu && !S.pairing.active) { pairedName = nu.name; pair = null; }
  }
  if (pair && !S.pairing.active && !pairedName && pair.expires < Date.now() / 1000) { pair = null; note.pair = "The code ran out. Make a new one."; }
  paint();
}
function tick() {
  if (pair && !pairedName && $("#left")) { const left = pair.expires - Date.now() / 1000; $("#left").textContent = `Waiting for the phone… ${clock(left)} left`; $("#leftbar").style.width = Math.max(0, 100 * left / (pair.total || 600)) + "%"; }
}
async function run(key, fn) { busy[key] = true; paint(); try { await fn(); } catch (e) { } busy[key] = false; await refresh(); }
document.addEventListener("input", e => { if (e.target.id === "code") typed = e.target.value; if (e.target.dataset.opt) opts[e.target.dataset.opt] = e.target.checked; });
document.addEventListener("keydown", e => { if (e.key === "Enter" && e.target.id === "code") $("[data-do=approve-typed]").click(); });
document.addEventListener("click", async e => {
  const b = e.target.closest("[data-do]"); if (!b || b.disabled) return; const d = b.dataset;
  if (d.do === "svc") run("svc", async () => { note.svc = ""; const r = await api("/api/service", { action: d.a }); if (!r.ok) note.svc = r.error || "That didn't work."; await new Promise(r => setTimeout(r, 1500)); });
  if (d.do === "pair") run("pair", async () => { note.pair = ""; pairedName = ""; known = new Set(S.devices.map(x => x.id));
    const r = await api("/api/pair", { viewer: opts.viewer, remote: opts.remote }); if (r.ok) pair = { ...r, total: r.expires - Date.now() / 1000 }; else note.pair = r.error; });
  if (d.do === "pair-cancel") run("pair", async () => { await api("/api/pair/cancel", {}); pair = null; });
  if (d.do === "pair-done") { pairedName = ""; pair = null; paint(); }
  if (d.do === "approve" || d.do === "approve-typed") { const code = d.do === "approve" ? d.code : typed.trim(); const k = d.do === "approve" ? "ap" + code : "aptyped";
    run(k, async () => { note.approve = ""; const r = await api("/api/approve", { code, viewer: !!d.viewer }); note.approveOk = r.ok; note.approve = r.ok ? "Approved." : r.error; if (r.ok) typed = ""; }); }
  if (d.do === "rm") { confirmRm = d.id; paint(); } if (d.do === "rm-no") { confirmRm = ""; paint(); }
  if (d.do === "rm-yes") run("rm", async () => { note.rm = ""; const r = await api("/api/remove", { id: d.id }); if (!r.ok) note.rm = r.error; confirmRm = ""; });
  if (d.do === "doctor") run("doctor", async () => { const r = await api("/api/doctor"); doc = r.checks || []; });
  if (d.do === "update") run("update", async () => { const r = await api("/api/update-check", {}); note.more = r.message || r.error || ""; });
  if (d.do === "test") run("test", async () => { const r = await api("/api/test-alert", {}); note.more = r.ok ? "Sent. It shows in the app's Inbox within a minute (and in Discord, if that's set up)." : r.error; });
  if (d.do === "activity") { if (act) { act = null; paint(); } else run("act", async () => { act = (await api("/api/activity")).lines || []; }); }
  if (d.do === "network") run("network", async () => { const r = await api("/api/network", {}); note.networkOk = r.ok; note.network = r.ok ? `This server's address is ${r.found.lan_host}. Nova was restarted.` : r.error; });
});
refresh().then(() => { if (AUTO === "pair" && S && S.running) { const b = $("[data-do=pair]"); if (b) b.click(); } AUTO = null; });
setInterval(refresh, 3000); setInterval(tick, 1000);
</script></body></html>"""


