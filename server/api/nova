#!/usr/bin/python3
"""Nova — everything you do on the server, in one command.  (run with sudo)

  Devices
    sudo nova add                  pair a phone or tablet (shows a QR code and a code to type)
         --viewer                  …as view-only     --user NAME   …for a person     --minutes N   (default 10)
         --remote                  …for a phone that is away from home (works over Tailscale or Cloudflare; the QR also holds a setup code to paste)
    sudo nova approve CODE         approve a code shown in a browser: adding the browser, or an action it's waiting on
         --viewer  --user NAME     (when adding a browser)
    sudo nova approve              list what's waiting for approval
    sudo nova devices              list paired phones, tablets and browsers
    sudo nova remove NAME|ID       remove one (it can never connect again)

  Server
    sudo nova status               version, services and addresses
    sudo nova doctor               check everything; each problem comes with how to fix it
    sudo nova setup                guided setup (network, remote access, location, tools…)
    nova gui                       the Nova Server window: status, pairing, devices and approvals without the terminal
    sudo nova update [--check]     install the newest signed release (--check: only look)
    nova version                   which Nova this is
    sudo nova uninstall [--purge]  remove Nova (--purge: its settings and paired devices too); containers and files stay
    sudo nova lighting             set up the fan/case lighting module
    sudo nova backup [now|list]    back up now, or list backups
    sudo nova log [N]              the last N things done through Nova (--raw: as logged)
    sudo nova alert LEVEL TITLE [DETAIL]   send an alert (info, warning, critical)
    sudo nova publish APK [NOTES]  put an app build in the in-app updater

  Several servers
    sudo nova link SERVER          show another Nova server here (it asks for approval on its side)
    sudo nova link                 list linked servers        sudo nova link --remove NAME   unlink one

  Plugins (docs/PLUGINS.md)
    sudo nova plugin list          what's installed
    sudo nova plugin add FOLDER    install a plugin (a folder with plugin.json) — it shows what it adds first
    sudo nova plugin remove ID     uninstall one

  Cloudflare (Labs → Cloudflare auto-setup)
    sudo nova cloudflare list      what Nova changed in your Cloudflare account
    sudo nova cloudflare undo      take it all back (e.g. before uninstalling); asks first
"""
import base64, hashlib, json, os, re, secrets, shutil, subprocess, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
LIB = "/usr/lib/nova-api" if os.path.isdir("/usr/lib/nova-api") else HERE
sys.path[:0] = [LIB, HERE]
import plat                                               # which OS this is, and where Nova's folders are on it
WIN = plat.WINDOWS
DATA = plat.p("/var/lib/nova-api"); DEVICES = os.path.join(DATA, "devices.json"); PAIRING = os.path.join(DATA, "pairing.json")
SHELL_APPROVE = os.path.join(DATA, "shell-approve.json"); PENDING = os.path.join(DATA, "pending.json")
CONFIG = plat.p("/etc/nova-api/config.json")
if WIN:                                                   # a Windows terminal: colors on, any character printable, and no "sudo"
    os.system("")
    for _s in (sys.stdout, sys.stderr):
        try: _s.reconfigure(encoding="utf-8", errors="replace")
        except Exception: pass
    import builtins
    def print(*a, **k): builtins.print(*[x.replace("sudo nova", "nova") if isinstance(x, str) else x for x in a], **k)   # noqa: A001
B, D, G, Y, R, X = "\033[1m", "\033[2m", "\033[32m", "\033[33m", "\033[31m", "\033[0m"
if not sys.stdout.isatty(): B = D = G = Y = R = X = ""

def load(p, d):
    try: return json.load(open(p))
    except Exception: return d

def save(p, o, mode=0o640, owner="nova-api"):
    import safeio                                         # the nova-api account owns these folders: no symlinks followed
    if WIN: return safeio.write_json(p, o, indent=1)      # (the folder's permissions decide who reads it there)
    import pwd, grp
    safeio.write_json(p, o, mode, pwd.getpwnam(owner).pw_uid if owner != "root" else 0, grp.getgrnam("nova-api").gr_gid, indent=1)

def opt(args, name, default=None):
    return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else default

def clock(sec): sec = max(0, int(sec)); return f"{sec // 60}:{sec % 60:02d}"

def run(*cmd):
    if not WIN: os.execvp(cmd[0], list(cmd))
    if os.path.basename(cmd[0]) == "nova-alert":          # Windows: the monitor takes alerts itself
        import winhost
        sys.exit(subprocess.run([sys.executable, winhost.MONITOR, "notify", *cmd[1:]]).returncode)
    tool = os.path.join(HERE, os.path.basename(cmd[0]))   # Windows: the same tools sit next to this file
    if not os.path.exists(tool): sys.exit("That isn't available on a Windows server yet.")
    sys.exit(subprocess.run([sys.executable, tool, *cmd[1:]]).returncode)

def is_root():
    if WIN:
        import winhost
        return winhost.is_admin()
    return os.geteuid() == 0

def api_state():
    """"active" when Nova's API is running."""
    if WIN:
        import winhost
        return winhost.task_state("Api")
    return subprocess.run(["systemctl", "is-active", "nova-api.service"], capture_output=True, text=True).stdout.strip()

def uninstall(rest):
    """Remove Nova the way it was installed: apt for the .deb, the tarball's own uninstaller otherwise. Asks first."""
    purge = "--purge" in rest
    if WIN:
        sys.exit('In an administrator PowerShell:  powershell -File "C:\\Program Files\\Nova\\uninstall.ps1"' + (" -Purge" if purge else ""))
    tar = os.path.join(LIB, "uninstall.sh")
    if os.path.exists(os.path.join(LIB, "INSTALLED_FROM_TARBALL")):                # (its uninstaller explains and asks)
        if not os.path.exists(tar): sys.exit("This Nova came from the tarball, but its uninstaller is missing — install the newest release first (sudo nova update), then run this again.")
        os.execvp("sh", ["sh", tar, *(["--purge"] if purge else [])])
    print(f"  {'Nova, its settings and its paired devices' if purge else 'Nova'} will be removed. Your containers, files and backups stay"
          + ("." if purge else "; its settings and paired devices stay too, for a reinstall (--purge removes them)."))
    os.execvp("apt-get", ["apt-get", "purge" if purge else "remove", "nova-server"])     # apt shows what it removes and asks

def version():
    """Nova's version as people see it everywhere else (0.9.17-alpha; Debian's package spells it 0.9.17~alpha)."""
    if os.path.exists(os.path.join(LIB, "VERSION")): v = open(os.path.join(LIB, "VERSION")).read().strip()
    else: v = subprocess.run(["dpkg-query", "-W", "-f=${Version}", "nova-server"], capture_output=True, text=True).stdout or "?"
    return v.replace("~", "-")

def ago(stamp):
    """'2026-11-10 19:36' → 'today 19:36' / 'yesterday' / '3 days ago' / '5 weeks ago'."""
    try: t = time.mktime(time.strptime(stamp[:16], "%Y-%m-%d %H:%M"))
    except (ValueError, TypeError): return stamp or "never"
    d = (time.time() - t) / 86400
    if time.strftime("%Y-%m-%d") == stamp[:10]: return "today " + stamp[11:16]
    if d < 2: return "yesterday"
    if d < 14: return f"{int(d)} days ago"
    if d < 30: return f"{int(d // 7)} weeks ago"
    return "a month ago" if d < 60 else f"{int(d // 30)} months ago"

def help_(): print(__doc__.rstrip()); print(f"\n  Short guides:  nova help TOPIC   ({', '.join(_guides().topics())})"); sys.exit(0)

def _guides():
    sys.path[:0] = [LIB, os.path.dirname(os.path.realpath(__file__))]
    import guides
    return guides

def menu():
    """Plain `nova`: the few things most people come for, not every command."""
    st = api_state()
    ver = version()
    setup = os.path.exists(CONFIG) if is_root() else st == "active"
    print(f"\n  {B}Nova {ver}{X}  " + (f"{G}● running{X}" if st == "active" else f"{Y}● not set up yet{X}" if not setup else f"{R}● stopped{X}"))
    rows = ([("sudo nova setup", "set Nova up (or: sudo nova setup --gui, in a browser)")] if not setup else []) + [
        ("sudo nova add", "pair a phone or tablet"), ("sudo nova approve CODE", "let in a browser that shows a code"),
        ("sudo nova status", "is everything running, and where"), ("sudo nova doctor", "find what's wrong, and how to fix it"),
        ("sudo nova link SERVER", "show another Nova server here"), ("sudo nova update", "install the newest version")] + (
        [("sudo nova setup", "change settings")] if setup else []) + (
        [("nova gui", "the same in a window (Nova Server)")] if setup and (WIN or os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")) else [])
    print(f"\n  {D}What would you like to do?{X}\n")
    for c, d in rows: print(f"    {B}{c:<24}{X} {d}")
    print(f"\n    {B}{'nova help':<24}{X} every command        {B}nova help TOPIC{X}  a short guide:")
    print(f"    {D}{' ' * 24} {', '.join(_guides().topics())}{X}\n")
    sys.exit(0)

def help_topic(t):
    g = _guides().guide(t.lower())
    if not g:
        import difflib
        near = difflib.get_close_matches(t.lower(), _guides().topics() + list(_guides().ALIASES), 1)
        sys.exit(f"No guide called \"{t}\"." + (f" Did you mean:  nova help {near[0]}" if near else "") + f"\nGuides: {', '.join(_guides().topics())}")
    title, body = g
    print(f"\n  {B}{title}{X}\n"); print("\n".join("  " + l if l else "" for l in body.splitlines())); print()
    sys.exit(0)

def doctor(args):
    found = _guides().doctor()
    try:                                                   # plus the machine checks setup runs (ports, systemd, clock…)
        if WIN: raise ImportError                          # (those are Linux's; Windows' are all in the doctor above)
        import preflight
        found += [{"level": c["level"], "title": c["title"], "fix": c["fix"]} for c in preflight.checks() if c["level"] != "ok"]
    except Exception: pass
    mark = {"ok": f"{G}✓{X}", "warn": f"{Y}!{X}", "stop": f"{R}✗{X}"}
    print(f"\n  {B}Nova doctor{X}\n")
    for c in found:
        print(f"  {mark.get(c['level'], '·')} {c['title']}")
        if c.get("fix"): print(f"      {D}→ {c['fix']}{X}")
    bad = [c for c in found if c["level"] != "ok"]
    print(f"\n  {G + 'All good.' + X if not bad else f'{len(bad)} thing' + ('s' if len(bad) > 1 else '') + ' to look at — the arrows say how.'}"
          f"  {D}More: nova help troubleshoot{X}\n")
    sys.exit(1 if any(c["level"] == "stop" for c in found) else 0)


def add(args):
    """Pair a phone/tablet: one-time code (+ QR), with a live countdown until it's used or runs out."""
    cfg = load(CONFIG, {})
    mins = int(opt(args, "--minutes", 10)); role = "viewer" if "--viewer" in args else opt(args, "--role", "admin")
    if role not in ("admin", "viewer"): sys.exit("--role must be admin or viewer")
    user = (opt(args, "--user", "") or "")[:40]
    code = "".join(secrets.choice("ABCDEFGHJKLMNPQRSTUVWXYZ23456789") for _ in range(10))
    expires = time.time() + mins * 60
    away = "--remote" in args                      # for a phone that isn't on the home network: also accepted from Tailscale / the Cloudflare address
    save(PAIRING, {"code_sha256": hashlib.sha256(code.encode()).hexdigest(), "expires": expires, "role": role, "user": user, **({"remote": True} if away else {})})
    lan, pin = cfg.get("lan_url", ""), ""
    try:      # the encrypted home-network listener: the app pins this exact certificate
        from cryptography import x509
        from cryptography.hazmat.primitives import serialization
        der = x509.load_pem_x509_certificate(open(f"{DATA}/tls/cert.pem", "rb").read()).public_bytes(serialization.Encoding.DER)
        pin = hashlib.sha256(der).hexdigest()
        lan = f"https://{cfg.get('lan_host') or '127.0.0.1'}:{cfg.get('tls_port', 8495)}"
    except Exception: pass
    info = {"nova": 1, "lan": lan, "pin": pin, "remote": cfg.get("remote_url", ""), "code": code}
    if away:                        # the ways in from outside: Tailscale's address, and the key to the Cloudflare door
        th = cfg.get("tailnet_host")
        try:                        # set up with its Tailscale address as "home" (setups before 0.9.20): that address is the way in
            import ipaddress
            if not th and ipaddress.ip_address(cfg.get("lan_host", "")) in ipaddress.ip_network("100.64.0.0/10"): th = cfg["lan_host"]
        except ValueError: pass
        if th: info["tailnet"] = f"https://{th}:{cfg.get('tls_port', 8495)}"
        if cfg.get("cf_client_id") and cfg.get("cf_client_secret"): info["cf"] = {"id": cfg["cf_client_id"], "secret": cfg["cf_client_secret"]}
        if not (info.get("tailnet") or info.get("cf")): sys.exit("This server has no way in from outside yet (Tailscale or a Cloudflare tunnel) — see: nova help remote")
    payload = json.dumps(info, separators=(",", ":"))
    setup = "nova1:" + base64.urlsafe_b64encode(payload.encode()).decode().rstrip("=")
    if "--json" in args:          # for the GUI setup: the same code and QR, as data (it shows them itself)
        svg = subprocess.run(["qrencode", "-t", "SVG", "-m", "2", "-o", "-", payload], capture_output=True, text=True).stdout if shutil.which("qrencode") else ""
        print(json.dumps({"payload": payload, "code": code, "host": cfg.get("lan_host", ""), "pin": " ".join(pin[i:i + 4].upper() for i in (0, 4, 8)), "expires": expires, "svg": svg, "role": role, "remote": away, "setup": setup if away else ""}))
        return
    if shutil.which("qrencode"): subprocess.run(["qrencode", "-t", "ANSIUTF8", "-m", "2", payload])
    elif not away: print(f"\n  {D}(For a QR code to scan, open the Nova Server window: nova gui){X}")
    if away:
        print(f"\nScan this with the Nova app {B}from anywhere{X} (or paste the setup code below into the app's “Away from home” box):")
        print(f"  {B}{setup}{X}")
        print(f"  {Y}Keep it private{X}: it works once, for the next {mins} minutes, and carries the key to your Cloudflare door — anyone who gets it in that time can pair.")
    else:
        print(f"\nScan this with the Nova app on your {B}home Wi-Fi{X}, or type it in:")
    print(f"  Server address  {B}{cfg.get('lan_host', '')}{X}      Code  {B}{code}{X}      Certificate  {pin[:4].upper()} {pin[4:8].upper()} {pin[8:12].upper()}")
    print(f"  It will be {'an Admin (full control)' if role == 'admin' else 'View only'}" + (f", for {user}" if user else "") + ". Single use.\n")
    before = set(load(DEVICES, {}))
    try:
        while True:
            left = expires - time.time()
            if not os.path.exists(PAIRING):
                new = [d for k, d in load(DEVICES, {}).items() if k not in before]
                print(f"\r  {G}✓ Paired{X} {new[0]['name'] if new else ''}" + " " * 30); return
            if left <= 0:
                try: os.remove(PAIRING)
                except OSError: pass
                print(f"\r  {Y}The code expired.{X} Run {B}sudo nova add{X} for a new one." + " " * 20); sys.exit(1)
            print(f"\r  Waiting for the phone… {B}{clock(left)}{X} left  {D}(Ctrl-C to stop waiting; the code stays valid){X}  ", end="", flush=True)
            time.sleep(1)
    except KeyboardInterrupt:
        print(f"\n  The code stays valid for {clock(expires - time.time())}.")


def approve(args):
    pend = load(PENDING, {}); now = time.time()
    browsers = [b for b in pend.get("browsers", []) if b["expires"] > now]
    actions = [a for a in pend.get("approvals", []) if a["expires"] > now]
    codes = [a for a in args if not a.startswith("--") and a not in (opt(args, "--user", "\0"), opt(args, "--role", "\0"))]
    if not codes:
        if not browsers and not actions:
            print("Nothing is waiting for approval."); print(f"{D}A browser shows its code under “Get a code”; an action it's waiting on shows one too.{X}"); return
        for b in browsers: print(f"  {B}{b['code']}{X}  " + (f"let the Nova server “{b['name']}” (from {b['from']}) show this one, read-only" if b.get("kind") == "head" else f"add the browser “{b['name']}” (from {b['from']})") + f" · {clock(b['expires'] - now)} left")
        for a in actions: print(f"  {B}{a['code']}{X}  {a['what']} — asked by {a['device']} · {clock(a['expires'] - now)} left")
        print(f"\nApprove one with: {B}sudo nova approve CODE{X}"); return
    code = codes[0].strip().upper().replace("-", "").replace(" ", "")
    b = next((x for x in browsers if x["code"].replace("-", "") == code), None)
    a = next((x for x in actions if x["code"] == code), None)
    if b: code = b["code"]
    role = "viewer" if "--viewer" in args else opt(args, "--role", "admin")
    if role not in ("admin", "viewer"): sys.exit("--role must be admin or viewer")
    what = (f"let the Nova server “{b['name']}” show this one (read-only)" if b and b.get("kind") == "head" else
            f"add the browser “{b['name']}” as {'Admin' if role == 'admin' else 'View only'}" if b else a["what"] if a else f"code {code}")
    if not b and not a:                                   # the API lists everything that's waiting (pending.json), so this code isn't
        print(f"{Y}Nothing is waiting with the code {code}{X} (codes expire after 10 minutes)."); approve([]); sys.exit(1)
    save(SHELL_APPROVE, {"code": code, "role": role, "user": (opt(args, "--user", "") or "")[:40], "t": now}, mode=0o640, owner="root")
    print(f"Approving: {what}  {D}(it's picked up within a few seconds){X}")
    try:
        for i in range(45):
            time.sleep(1)
            if not os.path.exists(SHELL_APPROVE): print(f"  {G}✓ Done.{X}"); return
            print(f"\r  waiting {clock(45 - i)} ", end="", flush=True)
    except KeyboardInterrupt: pass
    try: os.remove(SHELL_APPROVE)
    except OSError: pass
    sys.exit(f"\n  {Y}The browser didn't pick it up{X} — is its page still open? (Approvals made here last 2 minutes.)")


def devices(args):
    devs = load(DEVICES, {})
    if not devs: print("No devices yet. Pair one with: sudo nova add"); return
    rows, quiet = [], 0
    for k, d in sorted(devs.items(), key=lambda kv: kv[1].get("created", "")):
        kind = d.get("form") or ("desktop" if d.get("type") == "browser" else "phone")
        kind = {"desktop": "computer"}.get(kind, kind) + (" (browser)" if d.get("type") == "browser" else "")
        if d.get("type") in ("watch", "head"): kind = {"watch": "watch", "head": "Nova web (other server)"}[d["type"]]
        seen = d.get("last_seen") or ""
        try: old = time.time() - time.mktime(time.strptime(seen[:16], "%Y-%m-%d %H:%M")) > 30 * 86400
        except ValueError: old = False
        quiet += old
        rows.append((d["name"][:28], kind, "Admin" if d.get("role", "admin") == "admin" else "View only", (d.get("user") or "")[:18],
                     (ago(seen) if seen else "never") + (f" via {d['last_via']}" if d.get("last_via") else ""), k, old))
    w = [max(len(r[i]) for r in rows) for i in range(5)]
    print(f"  {D}{'NAME':{w[0]}}  {'KIND':{w[1]}}  {'ROLE':{w[2]}}  {'PERSON':{w[3]}}  {'LAST SEEN':{w[4]}}  ID{X}")
    for r in rows:
        print(f"  {B}{r[0]:{w[0]}}{X}  {r[1]:{w[1]}}  {r[2]:{w[2]}}  {r[3]:{w[3]}}  {(Y if r[6] else '')}{r[4]:{w[4]}}{X}  {D}{r[5]}{X}")
    if quiet: print(f"\n  {Y}{quiet}{X} {'has' if quiet == 1 else 'have'}n't connected in over a month. If one is gone for good:  sudo nova remove ID")


def remove(args):
    if not args: sys.exit("Which one? sudo nova remove NAME   (see: sudo nova devices)")
    devs = load(DEVICES, {}); hit = [k for k, d in devs.items() if args[0] in (k, d["name"])]
    if not hit: sys.exit(f"Nothing called {args[0]!r} — see: sudo nova devices")
    for k in hit: devs.pop(k)
    for k in [k for k, v in devs.items() if v.get("owner") in hit]: devs.pop(k); hit.append(k)       # a phone's watch goes with it
    save(DEVICES, devs, mode=0o640)
    for k in hit:                    # and its SSH key, if the app installed one
        h = f"{LIB}/helper" if os.path.exists(f"{LIB}/helper") and not WIN else None
        if h: subprocess.run([h, "ssh-unauthorize", k], capture_output=True)
    print(f"{G}✓ Removed{X} {', '.join(hit)}")


def status(args):
    cfg = load(CONFIG, {})
    print(f"{B}Nova {version()}{X}")
    if WIN:
        import winhost
        for t in ("Api", "Helper", "Alerts"):
            st = winhost.task_state(t); print(f"  {(G + '●') if st == 'active' else (R + '●')}{X} {'Nova ' + t:26} {st}")
    for u in () if WIN else ("nova-api", "nova-helper.socket", "nova-alerts.timer", "nova-backups.timer", "nova-update-check.timer", "nova-rgb-anim", "nova-rgb-tick.timer"):
        st = subprocess.run(["systemctl", "is-active", u], capture_output=True, text=True).stdout.strip()
        if st != "inactive" or u.startswith("nova-api"): print(f"  {(G + '●') if st == 'active' else (R + '●')}{X} {u:26} {st}")
    print(f"  Home network   {cfg.get('lan_url', '—')}")
    if cfg.get("tailnet_host"):
        here = True                                           # is Tailscale connected on this computer (its address here)?
        if not WIN:
            try: here = f"inet {cfg['tailnet_host']}/" in subprocess.run(["ip", "-o", "addr", "show"], capture_output=True, text=True, timeout=5).stdout
            except (OSError, subprocess.SubprocessError): pass
        print(f"  Tailscale      https://{cfg['tailnet_host']}:{cfg.get('tls_port', 8495)}" + ("" if here else f"   {Y}not connected on this computer (sudo nova doctor){X}"))
    print(f"  This computer  https://localhost:{cfg.get('tls_port', 8495)}")
    if cfg.get("remote_url"): print(f"  Remote         {cfg['remote_url']}")
    print(f"  Certificate    {short_pin(my_pin())}   (what phones and other servers check when they pair)")
    print(f"  Devices        {len(load(DEVICES, {}))}   (sudo nova devices)")
    print(f"\n  {D}Something wrong?  sudo nova doctor{X}")


def my_pin():
    try:
        from cryptography import x509
        from cryptography.hazmat.primitives import serialization
        der = x509.load_pem_x509_certificate(open(f"{DATA}/tls/cert.pem", "rb").read()).public_bytes(serialization.Encoding.DER)
        return hashlib.sha256(der).hexdigest()
    except Exception: return ""

def short_pin(p): return " ".join(p[i:i + 4].upper() for i in (0, 4, 8)) if p else "—"

def link(args):
    """Show another Nova server here (read-only, like Nova web's Servers page). That server's owner approves it
    there — in the Nova app, or with  sudo nova approve CODE  on that server."""
    sys.path[:0] = [LIB, os.path.dirname(os.path.realpath(__file__))]
    import nodes, pwd, grp
    def own():                                            # nodes.json belongs to the service, readable by it alone
        try: os.chown(nodes.FILE, pwd.getpwnam("nova-api").pw_uid, grp.getgrnam("nova-api").gr_gid); os.chmod(nodes.FILE, 0o600)
        except (OSError, KeyError): pass
    if not args:
        ns = nodes.status()
        if not ns: print("No other servers are linked here.  Add one:  sudo nova link SERVER   (its address, e.g. 192.168.1.20)"); return
        for n in ns: print(f"  {B}{n['name']:<24}{X} {n['host']:<18} {D}added {n.get('added', '')}{X}")
        print(f"\n  {D}Unlink one:  sudo nova link --remove NAME{X}"); return
    if args[0] == "--remove":
        name = " ".join(args[1:]).strip()
        n = next((x for x in nodes.status() if name and (x["name"] == name or x["host"] == name or x["id"] == name)), None)
        if not n: sys.exit(f"No linked server called \"{name}\".  See them:  sudo nova link")
        nodes.remove(n["id"]); own(); print(f"{G}✓{X} {n['name']} is no longer shown here."); return
    host = args[0]
    try: p = nodes.probe(host)
    except (ValueError, OSError) as e: sys.exit(f"{R}Couldn't reach Nova at {host}:{X} {e}\n  Is Nova running there, on your home network or tailnet?  (nova help servers)")
    print(f"\n  Found Nova {p.get('api', '')} at {B}{p['host']}{X}")
    print(f"  Its certificate:  {B}{p['pin_short']}{X}")
    print(f"  {D}To be sure it's really that server, check this matches the \"Certificate\" line of  sudo nova status  there.{X}")
    if input("\n  Link it? [Y/n]: ").strip().lower().startswith("n"): print("Nothing changed."); return
    cfg = load(os.path.join(DATA, "settings.json"), {})
    try: lk = nodes.link_start(p["host"], p["pin"], cfg.get("display_name") or plat.node())
    except (ValueError, OSError) as e: sys.exit(f"{R}{e}{X}")
    print(f"\n  Now approve it on that server, any one of:")
    print(f"    • the Nova app connected to it:  Menu → Users & devices → Approve a browser, code {B}{lk['code']}{X}")
    print(f"    • on that server:  {B}sudo nova approve {lk['code']}{X}")
    print(f"\n  {D}Waiting (up to 10 minutes, Ctrl-C to stop)…{X}", end="", flush=True)
    try:
        while True:
            time.sleep(2)
            try: r = nodes.link_poll(lk["id"])
            except OSError: continue
            except ValueError as e: sys.exit(f"\n{R}{e}{X}")
            if r["state"] == "approved":
                own()
                print(f"\n\n  {G}✓{X} {r['node']['name']} is linked: it shows in Nova web (Servers) on this server."); return
            if r["state"] == "expired": sys.exit("\n  That request expired. Run it again:  sudo nova link " + host)
    except KeyboardInterrupt: print("\n  Stopped — nothing was linked."); sys.exit(130)


def backup(args):
    sub = args[0] if args else "now"
    if sub == "now":
        r = subprocess.run([f"{LIB}/helper", "backup-now"], capture_output=True, text=True)
        try:
            j = json.loads(r.stdout or "{}")
            print(f"{G}✓ Backup started.{X} Follow it in the app (Inbox or Backups), or: sudo nova backup list" if j.get("ok", r.returncode == 0)
                  else f"{R}Couldn't start the backup:{X} {j.get('error') or r.stderr.strip()}")
        except ValueError: print(r.stdout.strip() or r.stderr.strip())
    elif sub == "list": backup_list()
    else: sys.exit("sudo nova backup [now|list]")


def backup_list():
    import backups
    jobs = backups.overview(); legacy = load("/var/lib/nova-backup/backup_status.json", None) if os.path.exists("/usr/local/bin/nova-backup") else None
    if not jobs and not legacy:
        print("No backups are set up yet. Set one up in the app or Nova web: Menu → Backups → New backup."); return
    for j in jobs:
        last = j.get("last") or {}
        state = f"{G}ok{X}" if last.get("ok") else f"{Y}partly{X}" if last.get("partial") else f"{R}failed{X}" if last else f"{D}not run yet{X}"
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(last["t"])) if last.get("t") else ""
        print(f"  {B}{j.get('name', j['id'])}{X}  last: {state} {D}{when}{X}" + (f"  {Y}running now{X}" if j.get("running") else "")
              + (f"  {D}next {time.strftime('%a %H:%M', time.localtime(j['next']))}{X}" if isinstance(j.get("next"), (int, float)) else ""))
        if last.get("error"): print(f"      {D}{last['error'][:160]}{X}")
    if legacy:
        print(("\n" if jobs else "") + f"  {B}Your nova-backup script{X}  last run {legacy.get('time', '?')}" + (f" · {legacy['snapshots']} snapshots" if legacy.get("snapshots") else "")
              + (f" · drive {legacy['drive']}" if legacy.get("drive") else ""))
        for name, st in (legacy.get("sets") or {}).items():
            good = st == "ok"
            print(f"    {G + '✓' if good else Y + '!'}{X} {name:12} {'' if good else st[:150]}")


def log(args):
    """The last N things done through Nova (and refused attempts), one line each. --raw: the log's own JSON lines."""
    n = int(args[0]) if args and args[0].isdigit() else 20
    lines = open(plat.p("/var/log/nova-api/audit.log"), errors="replace").readlines()[-n:]
    if "--raw" in args:
        for l in lines: print(l.rstrip())
        return
    for l in lines:
        try: e = json.loads(l)
        except ValueError: continue
        res = str(e.get("result", ""))
        mark = f"{G}✓{X}" if res.startswith("2") else f"{R}✗{X}" if res.startswith(("4", "5")) else " "
        what = f"{e.get('method', '') or ''} {str(e.get('path', '')).split('?')[0]}".strip()
        who = e.get("device") or e.get("ip") or ""
        print(f"  {D}{e.get('t', ''):19}{X} {mark} {what:42} {who[:26]:26} {D}{e.get('why') or (res if res and not res.startswith('2') else '')}{X}")


def plugin(args):
    sys.path.insert(0, "/usr/lib/nova-api"); sys.path.insert(1, os.path.dirname(os.path.realpath(__file__)))
    import plugins
    sub = args[0] if args else "list"
    if sub == "list":
        ps = plugins.all_plugins()
        if not ps: print("No plugins. Add one with:  sudo nova plugin add FOLDER   (see docs/PLUGINS.md)"); return
        for p in ps: print(f"  {p['id']:<24} {p['name']} {p['version']}  — {len(p['apps'])} app(s), {len(p['commands'])} tool(s)")
        return
    if sub == "add" and len(args) == 2:
        src = os.path.realpath(args[1]); man = os.path.join(src, "plugin.json")
        try: m = json.load(open(man))
        except Exception as e: sys.exit(f"Can't read {man}: {e}")
        pid = str(m.get("id", ""))
        if not re.fullmatch(plugins.ID_RE, pid) or "--" in pid: sys.exit("plugin.json needs an id: lowercase letters, digits and single dashes")
        print(f"\n  {m.get('name', pid)} {m.get('version', '')}  by {m.get('author', '?')}\n  {m.get('description', '')}\n")
        for x in m.get("apps", []): print(f"  app:   {x.get('name')}  → {x.get('url') or ':' + str(x.get('port'))}")
        for c in m.get("commands", []): print(f"  tool:  {c.get('name')}  — runs as your normal account:  {str(c.get('command'))[:120]}")
        if input("\n  Install it? [y/N]: ").strip().lower() != "y": print("  Not installed."); return
        dst = os.path.join(plugins.DIR, pid)
        os.makedirs(plugins.DIR, mode=0o755, exist_ok=True)
        if os.path.exists(dst): shutil.rmtree(dst)
        shutil.copytree(src, dst, symlinks=False)
        for root, dirs, files in os.walk(dst):          # root's, read-only for everyone else
            os.chown(root, 0, 0); os.chmod(root, 0o755)
            for f in files: fp = os.path.join(root, f); os.chown(fp, 0, 0); os.chmod(fp, 0o644)
        if not plugins.load(pid): shutil.rmtree(dst); sys.exit("  That plugin.json didn't check out (see docs/PLUGINS.md) — not installed.")
        print("  ✓ Installed. Its apps and tools are in Apps; switch it off in Settings → Plugins."); return
    if sub == "remove" and len(args) == 2:
        dst = os.path.join(plugins.DIR, args[1])
        if not re.fullmatch(plugins.ID_RE, args[1]) or not os.path.isdir(dst): sys.exit("No such plugin.")
        shutil.rmtree(dst); print("  ✓ Removed."); return
    sys.exit("usage: sudo nova plugin list | add FOLDER | remove ID")

def cloudflare(args):
    """What Nova changed in your Cloudflare account, and taking it all back (e.g. before uninstalling)."""
    sys.path.insert(0, "/usr/lib/nova-api"); sys.path.insert(1, os.path.dirname(os.path.realpath(__file__)))
    import cfsync
    led = cfsync.ledger(); sub = args[0] if args else "list"
    if sub == "list":
        if not led: print("Nova hasn't changed anything in your Cloudflare account."); return
        for h, r in led.items():
            what = "your existing address, put behind the login" if r.get("protected_existing") else "added by Nova (route, DNS record, login)"
            print(f"  {h:<36} {what}")
        return
    if sub == "undo":
        if not led: print("Nothing to undo — Nova hasn't changed your Cloudflare account."); return
        unprotect = "--unprotect" in args
        print("This takes off everything Nova added to your Cloudflare account:")
        for h, r in led.items():
            if r.get("protected_existing"): print(f"  {h:<36} " + ("login removed — it will be OPEN TO ANYONE again" if unprotect else "kept behind the login (it was yours before; add --unprotect to remove the login too)"))
            else: print(f"  {h:<36} route, DNS record and login removed")
        if input("\nGo ahead? [y/N]: ").strip().lower() != "y": print("Nothing changed."); return
        for h, r in cfsync.undo_all(unprotect).items(): print(f"  {h:<36} {r}")
        return
    sys.exit("usage: sudo nova cloudflare list | undo [--unprotect]")

