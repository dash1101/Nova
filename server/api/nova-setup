#!/usr/bin/python3
"""
nova-setup — guided setup for a Nova server. Safe to run again: your current settings are the
defaults, and pressing Enter keeps them.

    sudo nova-setup            interactive
    sudo nova-setup --yes      accept every detected default (unattended installs)
    sudo nova-setup --gui      the same in a browser (on this computer or another one at home)
    sudo nova-setup --answers FILE --yes    answers from a JSON file (what the browser setup uses)
    sudo nova-setup --check    only check this machine (ports, systemd, clock, network) and print what's wrong
"""
import getpass, glob, ipaddress, json, os, re, shutil, subprocess, sys

CONF = "/etc/nova-api/config.json"
YES = "--yes" in sys.argv
B, D, G, Y, R, X = "\033[1m", "\033[2m", "\033[32m", "\033[33m", "\033[31m", "\033[0m"
if not sys.stdout.isatty(): B = D = G = Y = R = X = ""


def sh(*cmd):
    try: r = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError: return 127, ""            # program not installed
    return r.returncode, r.stdout.strip()


# --answers FILE (the GUI setup, or an unattended install): a JSON object of answers, by key
ANSWERS = {}
if "--answers" in sys.argv:
    try: ANSWERS = json.load(open(sys.argv[sys.argv.index("--answers") + 1]))
    except (IndexError, OSError, ValueError) as e: sys.exit(f"can't read the answers file: {e}")

# `?` at any question: what this step is about, in plain words (then the question again)
STEP_HELP = {
    "Network": "Phones and browsers at home reach Nova at this server's address. Only devices on the home network you\n"
               "  name here may pair — a phone away from home can't add itself. The suggestions come from this machine's\n"
               "  network; Enter keeps them. If the address changes later (a new router), run sudo nova setup again.",
    "Away from home": "All optional — Nova works at home without either.\n"
                      "  Tailscale: a private network between your own devices; nothing opens to the internet. Easiest.\n"
                      "  Cloudflare Tunnel: a web address on your own domain, behind Cloudflare's login (needs a free account).\n"
                      "  Either way every request is still signed by your phone. More: nova help remote",
    "Notifications": "Alerts (a drive failing, a container crashing, a login) always show in the Nova app.\n"
                     "  Discord is an optional second copy: paste a channel's webhook address, or leave it empty.",
    "Tools": "Docker runs containers and the app store's apps; the drive tools (mergerfs, mdadm, smartmontools…) make\n"
             "  pools, RAID, NAS backups and drive tests work. Skipping is fine: Nova offers each one when you first need it.",
    "This server": "The account the in-app terminal signs in as (yours, not root); your town, for sunrise and sunset light\n"
                   "  schedules. The defaults are fine — Enter keeps them.",
    "Start Nova": "Saves your answers, opens Nova's ports (8495, 8496) to your home network only if a firewall is on, and\n"
                  "  starts Nova. Nothing outside your home network is opened.",
}
CUR = [""]

def _helped(a):
    if a.strip() not in ("?", "help"): return False
    print(f"\n  {B}{CUR[0] or 'Nova setup'}{X}\n  {STEP_HELP.get(CUR[0], 'Press Enter to keep the suggestion in [brackets]. More: nova help start')}\n")
    return True

def ask(q, default="", secret=False, key=None):
    if key in ANSWERS: return str(ANSWERS[key]).strip()
    if YES: return default
    shown = (" [" + ("•" * 6 if secret and default else default) + "]") if default else ""
    while True:
        a = (getpass.getpass if secret else input)(f"  {q}{D}{shown}{X}: ").strip()
        if not _helped(a): return a or default


def yes(q, default=True, key=None):
    if key in ANSWERS: return bool(ANSWERS[key])
    if YES: return default
    while True:
        a = input(f"  {q} {D}[{'Y/n' if default else 'y/N'}]{X}: ").strip().lower()
        if not _helped(a): return default if not a else a.startswith("y")


SECTIONS = ["Network", "Away from home", "Notifications", "Tools", "This server", "Start Nova"]

def step(n, title, about=""):
    """A clear header for each part: where you are, what it's for."""
    i = SECTIONS.index(title) + 1 if title in SECTIONS else n
    bar = "".join(f"{G}●{X}" if k < i else f"{B}●{X}" if k == i else f"{D}○{X}" for k in range(1, len(SECTIONS) + 1))
    CUR[0] = title
    print(f"\n{bar}  {B}Step {i} of {len(SECTIONS)} · {title}{X}  {D}(? for help){X}")
    if about: print(f"  {D}{about}{X}")

def ok(msg): print(f"  {G}✓{X} {msg}")
def warn(msg): print(f"  {Y}!{X} {msg}")
def info(msg): print(f"  {D}{msg}{X}")


def lan_guess():
    _, out = sh("ip", "-4", "route", "get", "1.1.1.1")
    ip = re.search(r"src (\S+)", out); dev = re.search(r"dev (\S+)", out)
    if not ip: return "", ""
    _, a = sh("ip", "-4", "-o", "addr", "show", "dev", dev.group(1))
    cidr = re.search(r"inet (\S+)", a)
    net = str(ipaddress.ip_interface(cidr.group(1)).network) if cidr else ip.group(1) + "/32"
    return ip.group(1), net


sys.path[:0] = ["/usr/lib/nova-api", os.path.dirname(os.path.realpath(__file__))]

def apt_install(pkgs, recommends=True):
    """Install with this Linux's package manager (apt, dnf, pacman or zypper), showing its output."""
    import pkg
    try: return pkg.install(pkgs, recommends=recommends, on_line=lambda l: print(f"    {D}{l}{X}"))[0] == 0
    except ValueError as e: warn(str(e)); return False


# ── 1. Network ──────────────────────────────────────────────────────────────────────────
def s_network(cfg, st):
    step(1, "Network", "How phones and browsers at home find this server. Only devices on this network can pair.")
    ip, net = lan_guess()
    while True:
        host = ask("This server's address at home", cfg.get("lan_host") or ip, key="lan_host")
        subnet = ask("Your home network", cfg.get("lan_subnet") or net, key="lan_subnet")
        try: ipaddress.ip_address(host); ipaddress.ip_network(subnet, strict=False); break
        except ValueError:
            if YES: sys.exit(f"{R}That address or network doesn't look right.{X}")
            warn("That doesn't look right — an address is like 192.168.1.20, a network like 192.168.1.0/24.")
    subnet = str(ipaddress.ip_network(subnet, strict=False))
    # Phones and browsers use the encrypted port on the network; plain HTTP stays on localhost (only for a local Cloudflare tunnel).
    cfg.update(lan_host=host, lan_subnet=subnet, lan_url=f"https://{host}:8495", port=cfg.get("port", 8095),
               tls_port=cfg.get("tls_port", 8495), bind=["127.0.0.1"])
    ok(f"Nova will be at https://{host}:8495")


# ── 2. Away from home ───────────────────────────────────────────────────────────────────
def s_remote(cfg, st):
    step(2, "Away from home", "Optional. Two ways to reach Nova and your apps when you're out — pick either, both, or neither.")
    print(f"  {B}Tailscale{X} {D}— a private network between your devices. Nothing is open to the internet.{X}")
    if not shutil.which("tailscale") and yes("Install Tailscale?", False, key="install_tailscale"):
        if subprocess.run("curl -fsSL https://tailscale.com/install.sh | sh", shell=True).returncode == 0:
            ok("Tailscale installed — sign in with the link below"); subprocess.run(["tailscale", "up"])
        else: warn("Tailscale didn't install — see tailscale.com/download/linux")
    rc, ts = sh("tailscale", "ip", "-4")
    if rc == 0 and ts:
        tip = ts.splitlines()[0]
        if yes(f"Let your Tailscale devices use Nova ({tip})?", True, key="use_tailscale"): cfg.update(tailnet_subnet="100.64.0.0/10", tailnet_host=tip); ok("Tailscale devices can use Nova")
        else: cfg.update(tailnet_subnet="", tailnet_host="")
    elif shutil.which("tailscale"): info("Tailscale is installed but not signed in — run: sudo tailscale up, then nova-setup again.")
    else: info("Skipped.")

    print(f"\n  {B}Cloudflare Tunnel{X} {D}— Nova and your apps on your own domain, behind a login. No open ports.{X}")
    if not shutil.which("cloudflared"):
        if yes("Install cloudflared?", False, key="install_cloudflared"):
            cmds = ["mkdir -p --mode=0755 /usr/share/keyrings",
                    "curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg -o /usr/share/keyrings/cloudflare-main.gpg",
                    "echo 'deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main' > /etc/apt/sources.list.d/cloudflared.list",
                    "apt-get update -qq", "DEBIAN_FRONTEND=noninteractive apt-get install -y cloudflared"]
            import pkg
            if pkg.which() != "apt": cmds = [{"dnf": "dnf install -y cloudflared || (curl -fsSL https://pkg.cloudflare.com/cloudflared-ascii.repo -o /etc/yum.repos.d/cloudflared.repo && dnf install -y cloudflared)",
                                               "pacman": "pacman -S --noconfirm cloudflared", "zypper": "zypper --non-interactive install cloudflared"}.get(pkg.which(), "false")]
            if all(subprocess.run(c, shell=True).returncode == 0 for c in cmds):
                ok("cloudflared installed")
                info("Tunnel token: Cloudflare dashboard → Zero Trust → Networks → Tunnels → your tunnel → install.")
                tok = ask("Paste the tunnel token (Enter to skip)", "", secret=True, key="tunnel_token")
                if tok: ok("Tunnel connected") if sh("cloudflared", "service", "install", tok)[0] == 0 else warn("Couldn't install the tunnel service — check the token")
            else: warn("cloudflared didn't install — see developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads")
        else: info("Skipped.")
    else: ok("cloudflared is installed")
    for k in ("remote_url", "cf_access_team", "cf_access_aud", "cf_client_id", "cf_client_secret"): cfg.setdefault(k, "")
    if shutil.which("cloudflared"):
        info("Nova's own address on your domain is set up by hand once (docs/REMOTE.md, about 5 minutes).")
        if yes("Enter those details now?", False, key="remote_manual"):
            cfg["remote_url"] = ask("Public address (https://…)", cfg.get("remote_url", ""))
            cfg["cf_access_team"] = ask("Cloudflare team domain (…cloudflareaccess.com)", cfg.get("cf_access_team", ""))
            cfg["cf_access_aud"] = ask("Access application AUD tag", cfg.get("cf_access_aud", ""))
            cfg["cf_client_id"] = ask("Service token client ID", cfg.get("cf_client_id", ""))
            cfg["cf_client_secret"] = ask("Service token client secret", cfg.get("cf_client_secret", ""), secret=True)
        elif cfg.get("remote_url"): ok(f"Kept {cfg['remote_url']}")


# ── 3. Notifications ────────────────────────────────────────────────────────────────────
def s_alerts(cfg, st):
    step(3, "Notifications", "Alerts always show in the Nova app. Discord is an extra copy, if you want one.")
    ap = "/etc/nova-alerts/config.json"
    try: ac = json.load(open(ap))
    except Exception: ac = {}
    have = bool(ac.get("discord_webhook"))
    if have: ok("Discord is set up")
    else: info("In Discord: a channel's settings → Integrations → Webhooks → New Webhook → Copy Webhook URL.")
    w = ask("Discord webhook link (Enter to " + ("keep it" if have else "skip") + ")", "", secret=True, key="discord_webhook")
    if w:
        if re.fullmatch(r"https://(discord|discordapp)\.com/api/webhooks/\d{5,25}/[A-Za-z0-9_-]{20,100}", w):
            ac["discord_webhook"] = w; os.makedirs("/etc/nova-alerts", exist_ok=True)
            tmp = ap + ".tmp"; json.dump(ac, open(tmp, "w"), indent=2); os.chmod(tmp, 0o600); os.replace(tmp, ap)
            ok("Saved — change it any time in the app (Notifications → Discord)")
        else: warn("That isn't a Discord webhook link — skipped.")


# ── 4. Tools ────────────────────────────────────────────────────────────────────────────
def s_tools(cfg, st):
    step(4, "Tools", "Optional programs. Skipping is fine — Nova offers each one the first time a feature needs it.")
    if shutil.which("docker") and (shutil.which("docker-compose") or sh("docker", "compose", "version")[0] == 0): ok("Docker is installed (containers and the app store)")
    elif yes("Install Docker — for containers and the app store?", not YES, key="install_docker"):
        import pkg
        pk = ["docker.io"] + ([p for p in ("docker-compose-v2", "docker-compose") if sh("apt-cache", "show", p)[0] == 0][:1] if pkg.which() == "apt" else ["docker-compose"])
        if apt_install(pk): sh("systemctl", "enable", "--now", "docker"); ok("Docker installed")
        else: warn(f"Docker didn't install — see docs.docker.com/engine/install for {pkg.label()}")
    try:
        from storage import missing_packages, TOOLS
        miss = missing_packages(list(TOOLS))
    except ImportError: miss = []
    if not miss: ok("Drive tools are installed (pools, RAID, NAS backups, tests)")
    elif yes(f"Install the drive tools — for pools, RAID, NAS backups and tests ({len(miss)} packages)?", True, key="install_tools"):
        ok("Installed") if apt_install(miss, recommends=False) else warn("Some didn't install — Nova offers each again when a feature needs it")
    # the assistant's brain: a small AI model on this server — off unless you ask for it here (or later, in the app)
    try: mem = int(open("/proc/meminfo").read().split()[1]) / 1e6
    except Exception: mem = 0
    info("Nova assistant (Labs): ask Nova in plain words, by voice or text. Its brain is a small AI model that runs only on this server.")
    if yes(f"Turn on the assistant and download its brain ({'2.5 GB, needs about 6 GB of memory' if mem >= 12 else '1.1 GB, needs about 3 GB of memory'})?", False, key="assistant"):
        st["assistant"] = "smart" if mem >= 12 else "light"
    if any("048D:00005702" in open(u).read().upper() for u in glob.glob("/sys/class/hidraw/hidraw*/device/uevent")):
        print(f"  {B}Lighting:{X} found a Gigabyte RGB Fusion 2 controller — set it up with {B}sudo nova-setup-lighting{X}")


# ── 5. This server ──────────────────────────────────────────────────────────────────────
def s_server(cfg, st):
    step(5, "This server", "Small details. The defaults are fine for most homes.")
    user = ask("Account the app's Terminal signs in as", cfg.get("ssh_user") or os.environ.get("SUDO_USER", ""), key="ssh_user")
    hosts = [{"name": "Home network", "host": cfg.get("lan_host", ""), "port": 22}]
    if cfg.get("tailnet_host"): hosts.append({"name": "Tailscale", "host": cfg["tailnet_host"], "port": 22})
    cfg.update(ssh_user=user, ssh_hosts=hosts)
    location()
    cfg.setdefault("protected_mounts", ["/", "/boot", "/boot/efi"]); cfg.setdefault("drive_roles", {})
    cfg.setdefault("update_source", "")
    if yes("Change advanced settings (protected drives, where updates come from)?", False, key="advanced"):
        info("Protected mounts can never be unmounted from the app.")
        prot = ask("Protected mounts (comma-separated)", ",".join(cfg["protected_mounts"]), key="protected_mounts")
        cfg["protected_mounts"] = sorted({p.strip() for p in prot.split(",") if p.strip()} | {"/", "/boot", "/boot/efi"})
        info("Nova only installs releases signed by the Nova release key.")
        info("github:owner/repo — GitHub releases · a folder — releases you copy over · blank — manual only")
        cfg["update_source"] = ask("Update source", cfg.get("update_source", ""), key="update_source")


def location():
    """Light schedules can start at sunrise or sunset — worked out here, offline."""
    sys.path.insert(0, "/usr/lib/nova-api")
    try: from nova_tz import tz_location; tzl = tz_location()
    except ImportError: tzl = None
    settings_f = "/var/lib/nova-api/settings.json"
    try: settings = json.load(open(settings_f))
    except Exception: settings = {}
    cur = settings.get("location")
    if tzl and not cur: info(f"For sunrise and sunset, Nova assumes near {tzl['name']} (from the time zone).")
    shown = f"{cur['lat']}, {cur['lon']}" if cur else ("time zone" if tzl else "")
    a = ask("Location for sunrise/sunset (latitude, longitude)", shown, key="location")
    if not a or a == shown: return
    if a.lower().replace(" ", "") in ("timezone", "tz"): settings.pop("location", None)
    else:
        try:
            lat, lon = (float(x) for x in a.replace(";", ",").split(",")[:2])
            if not (-90 <= lat <= 90 and -180 <= lon <= 180): raise ValueError
            settings["location"] = {"lat": round(lat, 2), "lon": round(lon, 2), "name": ""}
        except ValueError: return warn("That isn't 'latitude, longitude' (e.g. 40.71, -74.01) — kept as it was.")
    os.makedirs(os.path.dirname(settings_f), exist_ok=True)
    sys.path.insert(1, os.path.dirname(os.path.realpath(__file__)))
    import safeio                                     # the nova-api account owns this folder: no symlinks followed
    try: safeio.write_json(settings_f, settings, 0o640, "nova-api", "nova-api", indent=1)
    except KeyError: safeio.write_json(settings_f, settings, 0o640, indent=1)
    ok("Location saved")


# ── 6. Start ────────────────────────────────────────────────────────────────────────────
def save(cfg):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f: json.dump(cfg, f, indent=1)
    gid = int(sh("getent", "group", "nova-api")[1].split(":")[2]) if sh("getent", "group", "nova-api")[0] == 0 else 0
    os.chown(tmp, 0, gid); os.chmod(tmp, 0o640); os.replace(tmp, CONF)

def s_start(cfg, st):
    step(6, "Start Nova", "Saving your settings, opening the firewall for your home network, and starting Nova.")
    subnet, host = cfg["lan_subnet"], cfg["lan_host"]
    save(cfg); ok(f"Settings saved {D}({CONF}){X}")
    rc, fw = sh("ufw", "status")
    if rc == 0 and "Status: active" in fw:
        if yes(f"Let {subnet} through the firewall to Nova?", True, key="firewall"):
            sh("ufw", "allow", "from", subnet, "to", "any", "port", "8495", "proto", "tcp", "comment", "Nova (home network)")
            sh("ufw", "allow", "from", subnet, "to", "any", "port", "8496", "proto", "udp", "comment", "Nova discovery (home network)")
            ok("Firewall rules added")
    elif shutil.which("firewall-cmd") and sh("firewall-cmd", "--state")[1].strip() == "running":       # Fedora, openSUSE, RHEL
        if yes(f"Let {subnet} through the firewall to Nova?", True, key="firewall"):
            for port in ("8495/tcp", "8496/udp"):
                p, proto = port.split("/")
                sh("firewall-cmd", "--permanent", f"--add-rich-rule=rule family=ipv4 source address={subnet} port port={p} protocol={proto} accept")
            sh("firewall-cmd", "--reload"); ok("Firewall rules added")
    else: info(f"Firewall: make sure {subnet} can reach tcp 8495 (and udp 8496 to find the server).")
    sh("systemctl", "daemon-reload")
    sh("systemctl", "enable", "--now", "nova-helper.socket")
    sh("systemctl", "enable", "nova-api.service"); sh("systemctl", "restart", "nova-api.service")
    if sh("systemctl", "is-active", "nova-api.service")[0] != 0: sys.exit(f"  {R}Nova didn't start — see: journalctl -u nova-api -n 50{X}")
    ok("Nova is running")
    if st.get("assistant"):
        try:
            sp = "/var/lib/nova-api/settings.json"
            try: sj = json.load(open(sp))
            except Exception: sj = {}
            sj.setdefault("labs", {})["assistant"] = True
            json.dump(sj, open(sp + ".tmp", "w")); shutil.chown(sp + ".tmp", "nova-api", "nova-api"); os.chmod(sp + ".tmp", 0o640); os.replace(sp + ".tmp", sp)
            rc, out = sh("/usr/lib/nova-api/helper", "task-start", "brain-install", json.dumps({"model": st["assistant"]}))
            ok("The assistant is on — its brain is downloading in the background (see the app's Inbox)") if rc == 0 else warn("The assistant is on, but its brain didn't start downloading — get it from the assistant page in the app")
        except Exception as e: warn(f"Couldn't turn on the assistant ({e}) — turn it on in the app: Settings → Labs")
    try:
        import preflight, time; time.sleep(1.5)
        if not preflight.reachable(host): warn(f"Nova is running, but {host}:8495 doesn't answer — check the firewall and that {host} is this server's address")
    except Exception: pass
    print(f"\n  {B}All set.{X}")
    print(f"    App      pair with {B}sudo nova add{X} and scan the code with the Nova app (on your home Wi-Fi)")
    print(f"    Browser  https://{host}:8495/")
    print(f"    Later    run {B}sudo nova-setup{X} again to change any of this")
    if not YES and yes("\nPair your phone now?", True): os.execvp("nova", ["nova", "add"])


STEPS = [("Network", s_network), ("Away from home", s_remote), ("Notifications", s_alerts), ("Tools", s_tools), ("This server", s_server)]


def main():
    if os.geteuid() != 0: sys.exit("Run with sudo:  sudo nova-setup")
    if "--gui" in sys.argv:                               # the same setup in a browser (nova-setup-gui)
        g = shutil.which("nova-setup-gui") or os.path.join(os.path.dirname(os.path.realpath(__file__)), "nova-setup-gui")
        os.execv(sys.executable, [sys.executable, g])
    if "--check" in sys.argv: import preflight; print(json.dumps(preflight.checks(), indent=1)); return
    cfg = {}
    try: cfg = json.load(open(CONF))
    except Exception: pass
    st = {}
    print(f"\n{B}Nova setup{X}")
    # before anything changes: what would make Nova fail later (a taken port, no systemd, a wrong clock…)
    try:
        import preflight; found = [c for c in preflight.checks() if c["level"] != "ok" or c["fix"]]
    except Exception: found = []
    for c in found:
        (warn if c["level"] != "stop" else lambda m: print(f"  {R}✗{X} {m}"))(c["title"])
        if c["detail"]: info(c["detail"])
        if c["fix"]: info(f"→ {c['fix']}")
    if any(c["level"] == "stop" for c in found) and "--force" not in sys.argv:
        sys.exit(f"\n  {R}Fix the problem above, then run setup again{X} {D}(or add --force to go ahead anyway){X}")
    if cfg.get("lan_host") and not YES and not ANSWERS:
        # Already set up: change one part without walking through the rest
        print(f"  {D}Nova is set up. What would you like to change?{X}\n")
        for i, (name, _) in enumerate(STEPS, 1): print(f"    {B}{i}{X}  {name}")
        print(f"    {B}a{X}  Go through everything\n    {B}q{X}  Quit")
        a = input(f"\n  Choose {D}[a]{X}: ").strip().lower() or "a"
        if a == "q": return
        if a.isdigit() and 1 <= int(a) <= len(STEPS):
            STEPS[int(a) - 1][1](cfg, st); save(cfg); ok("Saved")
            sh("systemctl", "restart", "nova-api.service"); ok("Nova restarted with the new settings")
            return
    else:
        print(f"  {D}Six short steps. Press Enter to keep the suggestion in [brackets], or type ? for help — you can change everything later.{X}")
    for _, fn in STEPS: fn(cfg, st)
    s_start(cfg, st)


if __name__ == "__main__":
    try: main()
    except KeyboardInterrupt: print("\nCancelled — nothing else changed."); sys.exit(130)
