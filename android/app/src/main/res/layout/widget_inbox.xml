<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_dot" android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/widget_dot" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/w_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Nova" android:textColor="@color/w_text" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_age" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_sub" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/in_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3" android:gravity="center" android:text="All quiet" android:textColor="@color/w_sub" android:textSize="14sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/ev0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/ev0_d" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_dot" android:layout_marginEnd="10dp" />
        <TextView android:id="@+id/ev0_t" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/w_text" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/ev0_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/w_sub" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/ev1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/ev1_d" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_dot" android:layout_marginEnd="10dp" />
        <TextView android:id="@+id/ev1_t" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/w_text" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/ev1_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/w_sub" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/ev2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/ev2_d" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_dot" android:layout_marginEnd="10dp" />
        <TextView android:id="@+id/ev2_t" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/w_text" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/ev2_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/w_sub" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
