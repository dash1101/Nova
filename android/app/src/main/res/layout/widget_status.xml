<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_dot" android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/widget_dot" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/w_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Nova" android:textColor="@color/w_text" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_age" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_sub" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/st_head" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:gravity="center_vertical" android:text="Connecting…" android:textColor="@color/w_text" android:textSize="20sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/st_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/w_sub" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
