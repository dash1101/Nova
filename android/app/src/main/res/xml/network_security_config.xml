<?xml version="1.0" encoding="utf-8"?>
<!-- Nova's own connection to the server is HTTPS only — enforced in NovaApi (pinned certificate at
     home, Cloudflare's remotely). Plain HTTP is allowed here only so the Apps frame can open the
     web apps on your server, which are usually plain http on the home network. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
